{
  "scope": "Counterfactual loaded-table reloads are engineering faults, not changes to real historical UTC or independent astronomical events. Expected arithmetic is hand declared before code changes. No historical coefficient file is modified.",
  "historical_cases": [
    {
      "id": "sofa1960",
      "year": 1960,
      "table": "utc1960",
      "entry_effective": "1960-01-01",

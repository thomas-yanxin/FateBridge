# FateBridge runtime configuration
# Copy this file to .env and adjust values for your environment.

# REST API bind address and port
API_HOST=0.0.0.0
API_PORT=8010

# Comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000

# Application log level
LOG_LEVEL=INFO

# Solar-term Sun model: auto uses packaged raw DE440 orbit coefficients within
# the tested1700..2300 software range, without optional dependencies/downloads.
# Strict native JPL still overrides auto. native keeps the original native
# selection; analytic selects the earlier ERFA epv00 control; spk reads an
# explicitly selected external kernel; de440 explicitly selects packaged data.
# Explicit analytic/spk/de440/aa1996/vsop2013 conflicts with strict native JPL. Numerical gates
# do not certify all input times, physical UTC or traditional interpretation.
FATEBRIDGE_SOLAR_TERM_MODEL=auto
# Optional explicit high-precision solar SPK backend (install the jpl extra).
# FATEBRIDGE_SOLAR_TERM_MODEL=spk
# FATEBRIDGE_SOLAR_SPK_FILE=/absolute/path/to/de440.bsp
# Optional locally built AA1996/full-Moshier-Moon Sun model; no runtime build.
# Build with: python -m fatebridge.fetch_aa1996 --output /new/build/directory
# FATEBRIDGE_SOLAR_TERM_MODEL=aa1996
# FATEBRIDGE_AA1996_MANIFEST=/new/build/directory/manifest.json
# Optional full VSOP2013 EMB/full-Moshier-Moon Sun model, input years1700..2300.
# Build separately; no runtime compilation or implicit source substitution.
# uv run --locked --extra dev python -m fatebridge.fetch_vsop2013 --output /new/vsop-directory
# FATEBRIDGE_SOLAR_TERM_MODEL=vsop2013
# FATEBRIDGE_VSOP2013_MANIFEST=/new/vsop-directory/manifest.json

# Optional API key auth for REST endpoints.
# Format: name:key,name2:key2
FATEBRIDGE_API_KEYS=
API_KEY_HEADER_NAME=X-API-Key

# Optional stdio MCP tool families, e.g. bazi,astro,knowledge.
# Empty/unset keeps the complete tool set; invalid family names fail startup.
FATEBRIDGE_MCP_FAMILIES=
# Optional scenario IDs (CSV); intersects family selection.
FATEBRIDGE_MCP_SCENARIOS=

# complete includes conditional dependencies; topic requires a scenario and keeps
# only its direct tools plus knowledge support. Does not change REST/CLI.
FATEBRIDGE_MCP_TOOL_SCOPE=complete

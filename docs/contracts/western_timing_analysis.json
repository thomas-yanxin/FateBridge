        "description": "Birth place"
      },
      "birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from a supported birth_place. Western charts and timing reject an unresolved civil timezone; coordinates alone do not establish a zone. Supply UTC explicitly when that is the confirmed recorded basis. Place inference does not certify historical clock accuracy."
      },
      "birth_year": {
        "description": "Birth year, e.g., 1990",
        "type": "integer"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "ephemeris_policy": {
        "default": "auto",
        "description": "auto retains and reports actual available models. require_data_files rejects analytical/orbital fallback for observed physical coordinates throughout the request, including clocks and samples; checks data contexts and endpoint hashes. Native rise/set query/result epochs are probed, but internal solver reads are not fully observable. Analytical points, fictitious elements, reference zeros and Earth rotation are separate; this is not an astronomical-accuracy or prediction certificate.",
        "enum": [
          "auto",
          "require_data_files"
        ],
        "type": "string",
        "x-fatebridge-western-data-policy": true
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "firdaria_night_order": {
        "default": "nodes_at_end",
        "description": "Firdaria night order: nodes_at_end (existing default, after Mercury) or nodes_after_mars (Bonatti-labelled variant). Day order is unchanged.",
        "enum": [
          "nodes_at_end",
          "nodes_after_mars"
        ],
        "type": "string"
      },
      "firdaria_year_basis": {
        "default": "fixed_365_2425",
        "description": "Firdaria year basis: fixed_365_2425 (existing local-wall arithmetic) or calendar_anniversary (original-birth anniversaries, Feb 29 clamps to Feb 28 then restores; UTC elapsed subperiods). Calendar mode rejects ambiguous/nonexistent birth, analysis and generated anniversary clocks.",
        "enum": [
          "fixed_365_2425",
          "calendar_anniversary"
        ],
        "type": "string"
      },
      "house_system": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "default": "P",
        "description": "House system, any convention: SE letter ('P'=Placidus, 'R'=Regiomontanus, 'W'=whole sign, 'D'=equal_mc), key ('placidus', 'equal_mc'), or integer code 0..8 (3=Placidus, 8=equal_mc). Explicit values must be supported letters/names or integer codes0..8; unknown, blank, boolean and floating-point selections are rejected without substitution. Gauquelin (G) has36 clockwise sectors and is unavailable here."
      },
      "include_snapshot_text": {
        "default": true,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Name (optional)"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "pd_aspects": {
        "default": [

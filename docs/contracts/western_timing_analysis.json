      "birth_longitude": {
        "description": "Birth longitude",
        "maximum": 180,
        "minimum": -180,
        "type": "number"
      },
      "birth_minute": {
        "default": 0,
        "description": "Birth minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"

        "description": "Birth day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "birth_hour": {
        "description": "Birth hour (0-23)",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },

{
  "call_guidance": {
    "additional_systems": "可选include_yogini、include_ashtottari与include_chara（此时使用node_mode=mean|true）分别输出yogini、ashtottari与chara。",
    "birth_sensitivity": "vimshottari.birth_time_sensitivity（DashaGrid）输出status、nakshatra_options与sample_count。",
    "clock": "公历。analysis_year给定时缺月/日各取1，缺时/分取0；analysis_year省略时按as_of（或当前）在analysis_timezone下的当地瞬间计算，详见analysis_context（analysis_datetime、timezone、ayanamsa）。",
    "full_export": "完整JSON或时间线导出使用 include=[\"*\"]（默认省略次级细节路径见 run_metadata.omitted_fields），或使用evidence_views（stage、timeline）。",
    "periods": "基于Moon宿度，次运从完整原始主运按比例起算；year_basis支持julian_365_25（默认）、sidereal_365_25636、tropical_365_2425与savana_360（见vimshottari.year_days），dasha_depth支持2..6层。vimshottari.timeline_scope为120年规则周期。",
    "strength": "本命力量与时标细节可另调用vedic_chart工具读取vedic_chart.strengths.sthana_bala与vedic_chart.profile.time_scale_context，不把位置强度直接写成事件概率。"
  },
  "default_omit": [
    "vimshottari.timeline.*.antardashas",
    "vimshottari.subdivisions.siblings_by_level",
    "vimshottari.birth_time_sensitivity",
    "vimshottari.rule_ids",
    "yogini.timeline",
    "ashtottari.timeline",
    "chara.timeline"
  ],
  "evidence_views": {
    "stage": {
      "fields": [
        "analysis_context",
        "person_info",
        "vimshottari.method_id",
        "vimshottari.year_basis",
        "vimshottari.seed",
        "vimshottari.birth_balance",
        "vimshottari.current_major",
        "vimshottari.current_sub",
        "vimshottari.timeline",
        "summary"
      ],
      "purpose": "当前大运/子运阶段与出生剩余运"
    },
    "timeline": {
      "fields": [
        "analysis_context",
        "vimshottari.seed",
        "vimshottari.birth_balance",
        "vimshottari.timeline",
        "summary"
      ],
      "purpose": "完整120年大运/子运时间轴"
    }
  },
  "first_view": {
    "fields": [
      "analysis_context",
      "person_info",
      "vimshottari.method_id",
      "vimshottari.year_basis",
      "vimshottari.seed",
      "vimshottari.birth_balance",
      "vimshottari.current_major",
      "vimshottari.current_sub",
      "vimshottari.timeline",
      "summary"
    ]
  },
  "input": {
    "additionalProperties": false,
    "properties": {
      "analysis_day": {
        "anyOf": [
          {
            "maximum": 31,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析公历日",
        "title": "Analysis Day"
      },
      "analysis_hour": {
        "anyOf": [
          {
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析小时",
        "title": "Analysis Hour"
      },
      "analysis_minute": {
        "anyOf": [
          {
            "maximum": 59,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析分钟",
        "title": "Analysis Minute"
      },
      "analysis_month": {
        "anyOf": [
          {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析公历月",
        "title": "Analysis Month"
      },
      "analysis_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析时刻时区",
        "title": "Analysis Timezone"
      },
      "analysis_year": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "分析公历年",
        "title": "Analysis Year"
      },
      "ayanamsa": {
        "default": "lahiri",
        "description": "恒星岁差体系",
        "enum": [
          "lahiri",
          "true_citra",
          "raman",
          "kp",
          "true_pushya"
        ],
        "title": "Ayanamsa",
        "type": "string"
      },
      "birth_day": {
        "description": "公历出生日",
        "maximum": 31,
        "minimum": 1,
        "title": "Birth Day",
        "type": "integer"
      },
      "birth_hour": {
        "description": "出生小时（0-23）",
        "maximum": 23,
        "minimum": 0,
        "title": "Birth Hour",
        "type": "integer"
      },
      "birth_latitude": {
        "anyOf": [
          {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": 28.6139,
        "description": "出生地纬度",
        "title": "Birth Latitude"
      },
      "birth_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": 77.209,
        "description": "出生地经度",
        "title": "Birth Longitude"
      },
      "birth_minute": {
        "default": 0,
        "description": "出生分钟（0-59）",
        "maximum": 59,
        "minimum": 0,
        "title": "Birth Minute",
        "type": "integer"
      },
      "birth_month": {
        "description": "公历出生月",
        "maximum": 12,
        "minimum": 1,
        "title": "Birth Month",
        "type": "integer"
      },
      "birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "出生地名称",
        "title": "Birth Place"
      },
      "birth_second": {
        "default": 0,
        "description": "出生秒（0-60）",
        "maximum": 60,
        "minimum": 0,
        "title": "Birth Second",
        "type": "integer"
      },
      "birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "IANA 时区或 UTC 偏移",
        "title": "Birth Timezone"
      },
      "birth_year": {
        "description": "公历出生年",
        "maximum": 2399,
        "minimum": 1800,
        "title": "Birth Year",
        "type": "integer"
      },
      "dasha_depth": {
        "default": 2,
        "description": "达沙递归层数（2-6）",
        "maximum": 6,
        "minimum": 2,
        "title": "Dasha Depth",
        "type": "integer"
      },
      "ephemeris_policy": {
        "default": "auto",
        "description": "星历数据策略：auto 或 require_data_files",
        "enum": [
          "auto",
          "require_data_files"
        ],
        "title": "Ephemeris Policy",
        "type": "string"
      },
      "include_ashtottari": {
        "default": false,
        "description": "是否附带108年Ashtottari Dasha",
        "title": "Include Ashtottari",
        "type": "boolean"
      },
      "include_chara": {
        "default": false,
        "description": "是否附带Jaimini Chara Dasha",
        "title": "Include Chara",
        "type": "boolean"
      },
      "include_yogini": {
        "default": false,
        "description": "是否附带36年Yogini Dasha",
        "title": "Include Yogini",
        "type": "boolean"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "姓名或备注，不参与计算",
        "title": "Name"
      },
      "node_mode": {
        "default": "mean",
        "description": "罗睺/计都交点模式（include_chara 时使用）",
        "enum": [
          "mean",
          "true"
        ],
        "title": "Node Mode",
        "type": "string"
      },
      "year_basis": {
        "default": "julian_365_25",
        "description": "达沙年长口径",
        "enum": [
          "julian_365_25",
          "sidereal_365_25636",
          "tropical_365_2425",
          "savana_360"
        ],
        "title": "Year Basis",
        "type": "string"
      }
    },
    "required": [
      "birth_year",
      "birth_month",
      "birth_day",
      "birth_hour"
    ],
    "title": "VimshottariDashaRequest",
    "type": "object"
  },
  "tool": "vimshottari_dasha"
}

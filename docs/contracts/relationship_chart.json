    "marks_charts.*.chart_profile.derivation_policy",
    "marks_charts.*.chart_profile.aspect_policy",
    "marks_charts.*.chart_profile.physical_ephemeris_source"
  ],
  "evidence_views": {
    "compare": {
      "aliases": [
        "compare",
        "comparison",
        "comp",
        "比较盘",
        "Comp",
        0
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "synastry_aspects",
        "in_to_out_aspects",
        "out_to_in_aspects"
      ],
      "primary_layer": "directional_synastry",
      "relative_mode": "compare",
      "when": "比较双方跨盘互动；按 A→B 与 B→A 分开读"
    },
    "composite": {
      "aliases": [
        "组合盘",
        "composite",
        "Composite",
        1
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "chart"
      ],
      "primary_layer": "composite_chart",
      "relative_mode": "composite",
      "when": "用户指定组合盘，解释合成关系结构"
    },
    "influence": {
      "aliases": [
        "influence",
        "synastry",
        "影响盘",
        "Synastry",
        2
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "inner.chart_profile",
        "inner.chart.angles",
        "inner.chart.houses",
        "inner.chart.planets",
        "outer.chart_profile",
        "outer.chart.angles",
        "outer.chart.houses",
        "outer.chart.planets"
      ],
      "primary_layer": "influence_chart_pair",
      "relative_mode": "influence",
      "when": "用户指定影响盘／Synastry，分别读双方视角；inner/outer不是各自本命"
    },
    "marks": {
      "aliases": [
        "marks",
        "马克斯盘",
        "Marks",
        4
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "marks_charts"
      ],
      "primary_layer": "marks_chart_pair",
      "relative_mode": "marks",
      "when": "用户指定马克斯盘；分别读取内方与外方个人盘，chart只是内方别名"
    },
    "relationship_detail": {
      "fields": [
        "relationship_profile",
        "in_to_out_midpoint",
        "out_to_in_midpoint",
        "in_to_out_antiscia",
        "out_to_in_antiscia",
        "in_to_out_contra_antiscia",
        "out_to_in_contra_antiscia"

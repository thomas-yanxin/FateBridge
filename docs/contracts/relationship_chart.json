  "input": {
    "additionalProperties": false,
    "description": "Flat (non-nested) relative/synastry chart request for tool surfaces.",
    "properties": {
      "composite_house_method": {
        "default": "cusp_midpoints",
        "description": "Composite house cusp method: 'cusp_midpoints' (default short-arc cusp midpoints) or 'mc_latitude' (Composite MC + mean latitude derived houses).",
        "enum": [
          "cusp_midpoints",
          "mc_latitude"
        ],
        "title": "Composite House Method",
        "type": "string"
      },
      "davison_variant": {
        "default": "uncorrected",
        "description": "TimeSpace/Marks variant: uncorrected, MC-axis corrected, or spherical geographic midpoint. UT1 arithmetic time mean; nondefault variants require TimeSpace or Marks.",
        "enum": [
          "uncorrected",
          "corrected",
          "spherical"
        ],
        "title": "Davison Variant",
        "type": "string"
      },
      "high_latitude_fallback": {
        "default": "error",
        "description": "Fallback when quadrant houses fail at high latitudes: error (default), porphyry, or whole_sign.",
        "enum": [
          "error",
          "porphyry",
          "whole_sign"
        ],
        "title": "High Latitude Fallback",
        "type": "string"
      },
      "house_system": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "default": "P",
        "description": "House system identifier (0..8, SE letter, or key). Defaults to Placidus ('P') to match the natal chart. Explicit values must be integer codes 0..8 or supported offline house letters/names (W, B, R, P, K, V, T, S, D, E); boolean, floating-point, blank and unsupported values are rejected.",
        "title": "House System"
      },
      "inner_birth_day": {
        "description": "Inner chart birth day",
        "maximum": 31,
        "minimum": 1,
        "title": "Inner Birth Day",
        "type": "integer"
      },
      "inner_birth_hour": {
        "description": "Inner chart birth hour",
        "maximum": 23,
        "minimum": 0,
        "title": "Inner Birth Hour",
        "type": "integer"
      },
      "inner_birth_latitude": {
        "description": "Inner latitude",
        "maximum": 90,
        "minimum": -90,
        "title": "Inner Birth Latitude",
        "type": "number"
      },
      "inner_birth_longitude": {
        "description": "Inner longitude",
        "maximum": 180,
        "minimum": -180,
        "title": "Inner Birth Longitude",
        "type": "number"
      },
      "inner_birth_minute": {
        "default": 0,
        "description": "Inner birth minute",
        "maximum": 59,
        "minimum": 0,
        "title": "Inner Birth Minute",
        "type": "integer"
      },
      "inner_birth_month": {
        "description": "Inner chart birth month",
        "maximum": 12,
        "minimum": 1,
        "title": "Inner Birth Month",
        "type": "integer"
      },
      "inner_birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Inner birth place",
        "title": "Inner Birth Place"
      },
      "inner_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Inner timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from supported inner_birth_place; no implicit UTC is selected when unresolved. A hardcoded 'UTC' default silently treated an eastern wall-clock time as UTC and rotated the chart.",
        "title": "Inner Birth Timezone"
      },
      "inner_birth_year": {
        "description": "Inner chart birth year",
        "maximum": 9999,
        "minimum": 1,
        "title": "Inner Birth Year",
        "type": "integer"
      },
      "inner_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "内盘",
        "description": "Inner chart name",
        "title": "Inner Name"
      },
      "inner_use_true_solar_time": {
        "default": false,
        "description": "Use apparent solar time for the inner chart",
        "title": "Inner Use True Solar Time",
        "type": "boolean"
      },
      "outer_birth_day": {
        "description": "Outer chart birth day",
        "maximum": 31,
        "minimum": 1,
        "title": "Outer Birth Day",
        "type": "integer"
      },
      "outer_birth_hour": {
        "description": "Outer chart birth hour",
        "maximum": 23,
        "minimum": 0,
        "title": "Outer Birth Hour",
        "type": "integer"
      },
      "outer_birth_latitude": {
        "description": "Outer latitude",
        "maximum": 90,
        "minimum": -90,
        "title": "Outer Birth Latitude",
        "type": "number"
      },
      "outer_birth_longitude": {
        "description": "Outer longitude",
        "maximum": 180,
        "minimum": -180,
        "title": "Outer Birth Longitude",
        "type": "number"
      },
      "outer_birth_minute": {
        "default": 0,
        "description": "Outer birth minute",
        "maximum": 59,
        "minimum": 0,
        "title": "Outer Birth Minute",
        "type": "integer"
      },
      "outer_birth_month": {
        "description": "Outer chart birth month",
        "maximum": 12,
        "minimum": 1,
        "title": "Outer Birth Month",
        "type": "integer"
      },
      "outer_birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Outer birth place",
        "title": "Outer Birth Place"
      },
      "outer_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Outer timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from supported outer_birth_place; no implicit UTC is selected when unresolved. A hardcoded 'UTC' default silently treated an eastern wall-clock time as UTC and rotated the chart.",
        "title": "Outer Birth Timezone"
      },
      "outer_birth_year": {
        "description": "Outer chart birth year",
        "maximum": 9999,
        "minimum": 1,
        "title": "Outer Birth Year",
        "type": "integer"
      },
      "outer_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "外盘",
        "description": "Outer chart name",
        "title": "Outer Name"
      },
      "outer_use_true_solar_time": {
        "default": false,
        "description": "Use apparent solar time for the outer chart",
        "title": "Outer Use True Solar Time",
        "type": "boolean"
      },
      "relationship_focus": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional relationship intent lens: marriage/婚姻 or romance/恋爱; adds a focus block + intent-filtered synastry aspects. Default/unset is general (no filtering).",
        "title": "Relationship Focus"
      },
      "relative_mode": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Relative mode selector",
        "title": "Relative Mode"
      },
      "zodiac_type": {
        "default": "Tropic",
        "description": "Zodiac type: Tropic or Sidereal",
        "enum": [
          "Tropic",
          "Sidereal"
        ],
        "title": "Zodiac Type",
        "type": "string"
      }
    },
    "required": [
      "inner_birth_year",
      "inner_birth_month",
      "inner_birth_day",
      "inner_birth_hour",
      "inner_birth_longitude",
      "inner_birth_latitude",
      "outer_birth_year",
      "outer_birth_month",
      "outer_birth_day",
      "outer_birth_hour",
      "outer_birth_longitude",
      "outer_birth_latitude"
    ],
    "title": "AstroRelativeFlatRequest",
    "type": "object"
  },
  "tool": "relationship_chart"
}

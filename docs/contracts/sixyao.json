{
  "evidence_views": {
    "line_reading": {
      "fields": [
        "input_normalized",
        "nongli",
        "current_hexagram",
        "changed_hexagram",
        "moving_lines",
        "lines",
        "hexagram_info",
        "liuyao_evidence",
        "classical_text_evidence",
        "summary"
      ],
      "when": "读取逐爻纳支、世应、原典动爻及月令动静条件；focus_line/focus_kinship为明确取用前提，日级候选不等于事件应期"
    }
  },
  "first_view": {
    "fields": [
      "input_normalized",
      "nongli",
      "current_hexagram",
      "changed_hexagram",
      "moving_lines",
      "lines",
      "hexagram_info",
      "liuyao_evidence",
      "classical_text_evidence",
      "summary"
    ],
    "include_snapshot_text": false,
    "strict_fields": true
  },
  "input": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Freeze implicit current time: ISO 8601 datetime with timezone"
      },
      "changed_code": {
        "anyOf": [
          {
            "pattern": "^[01]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Changed hexagram code, initial line first"
      },
      "coins": {
        "anyOf": [
          {
            "items": {
              "maximum": 9,
              "minimum": 6,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "摇钱起卦六掷之和（初爻→上爻），每掷为三枚铜钱之和 6/7/8/9（字面=2、背面=3）。提供则按真实摇出的铜钱结果装卦。"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "date": {
        "description": "Date string, e.g. 2028-04-06",
        "type": "string"
      },
      "event_horizon": {
        "anyOf": [
          {
            "enum": [
              "near",
              "long_term"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "调用方已明确问近事near或久远long_term时传入；用于原典进退条件，未给保持待定，不从timing_days推断"
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "focus_kind": {
        "anyOf": [
          {
            "enum": [
              "visible",
              "changed",
              "hidden",
              "month",
              "day"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "明确取本爻visible、实际变爻changed、已列伏神hidden、月建month或日辰day；日月不带爻位，未指定时保留本变候选"
      },
      "focus_kinship": {
        "anyOf": [
          {
            "enum": [
              "父母",
              "兄弟",
              "子孙",
              "妻财",
              "官鬼"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "明确选用的六亲；多现保留候选，与focus_line并用时须一致"
      },
      "focus_line": {
        "anyOf": [
          {
            "maximum": 6,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "调用方明确选定的用神爻位，初爻为1；默认取本爻，focus_kind可选变爻或已列伏神"
      },
      "gps_lat": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "GPS latitude"
      },
      "gps_lon": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "GPS longitude"
      },
      "gua_code": {
        "anyOf": [
          {
            "pattern": "^[01]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Current hexagram code, initial line first"
      },
      "include_snapshot_text": {
        "default": true,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "lat": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "31n13",
        "description": "Latitude text or decimal"
      },
      "lines": {
        "default": [],
        "description": "Optional six lines, initial line first",
        "items": {
          "additionalProperties": false,
          "description": "One six-yao line item.",
          "properties": {
            "change": {
              "default": false,
              "description": "Whether the line is moving",
              "type": "boolean"
            },
            "god": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional six-god label"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional line label"
            },
            "value": {
              "description": "0 for yin, 1 for yang",
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        },
        "maxItems": 6,
        "type": "array"
      },
      "lon": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "121e28",
        "description": "Longitude text or decimal"
      },
      "method": {
        "default": "auto",
        "description": "起卦方式：auto（默认，缺卦则按时刻时间起卦）/ coin（真·摇钱起卦，系统随机六掷）/ time（时间起卦）。提供 coins/lines/gua_code 时优先使用所提供的卦，重复输入必须一致。",
        "type": "string"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Question or topic"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "seed": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "随机摇钱起卦的随机种子（method=coin 且未提供 coins 时），用于复现同一卦。"
      },
      "strict_fields": {
        "default": false,
        "description": "是否拒绝无效 fields 路径；默认 false，使用宽松投影并返回警告。",
        "type": "boolean"
      },
      "time": {
        "description": "Time string, e.g. 09:33:00",
        "type": "string"
      },
      "timing_days": {
        "default": 0,
        "description": "按已明确的用爻列未来0至60个干支日的条件候选；0不展开，不是事件发生保证",
        "maximum": 60,
        "minimum": 0,
        "type": "integer"
      },
      "trace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Caller trace ID"
      },
      "zone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "+08:00",
        "description": "Timezone spec"
      }
    },
    "required": [
      "date",
      "time"
    ],
    "type": "object"
  },
  "tool": "sixyao"
}

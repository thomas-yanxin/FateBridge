        "enum": [
          "general",
          "marriage",
          "friendship",
          "business",
          "family"
        ],
        "type": "string"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "strict_fields": {
        "default": false,

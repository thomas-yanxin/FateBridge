{
  "first_view": {
    "fields": [
      "summary",
      "strengths",
      "challenges",
      "traditional_compatibility",
      "detailed_analysis",
      "recommendations",
      "person_info",
      "element_relationship"
    ],
    "include_snapshot_text": false,
    "strict_fields": true
  },
  "input": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Freeze implicit current time: ISO 8601 datetime with timezone"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "include_snapshot_text": {
        "default": true,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "person1_birth_day": {
        "description": "First person birth day",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "person1_birth_hour": {
        "description": "First person birth hour",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "person1_birth_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "First person birth longitude"
      },
      "person1_birth_minute": {
        "default": 0,
        "description": "First person birth minute",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      },
      "person1_birth_month": {
        "description": "First person birth month",
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
      },
      "person1_birth_place": {
        "default": "未提供",
        "description": "First person birth place",
        "type": "string"
      },
      "person1_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "First person birth timezone"
      },
      "person1_birth_year": {
        "description": "First person birth year, e.g., 1990",
        "type": "integer"
      },
      "person1_gender": {
        "default": "未知",
        "description": "第一人性别（影响大运顺逆与部分六亲判断）。接受 男/女、male/female/m/f、阳/阴、乾/坤 等写法；省略默认 未知。",
        "type": "string"
      },
      "person1_name": {
        "description": "First person name",
        "type": "string"
      },
      "person1_use_true_solar_time": {
        "default": true,
        "description": "Enable true solar time for first person (八字 default on)",
        "type": "boolean"
      },
      "person2_birth_day": {
        "description": "Second person birth day",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "person2_birth_hour": {
        "description": "Second person birth hour",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "person2_birth_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Second person birth longitude"
      },
      "person2_birth_minute": {
        "default": 0,
        "description": "Second person birth minute",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      },
      "person2_birth_month": {
        "description": "Second person birth month",
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
      },
      "person2_birth_place": {
        "default": "未提供",
        "description": "Second person birth place",
        "type": "string"
      },
      "person2_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Second person birth timezone"
      },
      "person2_birth_year": {
        "description": "Second person birth year, e.g., 1992",
        "type": "integer"
      },
      "person2_gender": {
        "default": "未知",
        "description": "第二人性别（影响大运顺逆与部分六亲判断）。接受 男/女、male/female/m/f、阳/阴、乾/坤 等写法；省略默认 未知。",
        "type": "string"
      },
      "person2_name": {
        "description": "Second person name",
        "type": "string"
      },
      "person2_use_true_solar_time": {
        "default": true,
        "description": "Enable true solar time for second person (八字 default on)",
        "type": "boolean"
      },
      "relationship_type": {
        "default": "general",
        "description": "关系类型：general / marriage / friendship / business / family。用户未说明关系时保留 general；不能因两人性别或‘我们两个人’推断为婚姻。",
        "enum": [
          "general",
          "marriage",
          "friendship",
          "business",
          "family"
        ],
        "type": "string"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "strict_fields": {
        "default": false,
        "description": "是否拒绝无效 fields 路径；默认 false，使用宽松投影并返回警告。",
        "type": "boolean"
      },
      "trace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Caller trace ID"
      }
    },
    "required": [
      "person1_name",
      "person1_birth_year",
      "person1_birth_month",
      "person1_birth_day",
      "person1_birth_hour",
      "person2_name",
      "person2_birth_year",
      "person2_birth_month",
      "person2_birth_day",
      "person2_birth_hour"
    ],
    "type": "object"
  },
  "tool": "two_person_compatibility"
}

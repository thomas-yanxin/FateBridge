{
  "call_guidance": {
    "additional_balas": "dig_bala、naisargika_bala与drik_bala（含natures、status、summary）按恒星黄道及实际上升/天顶角点计算；kala_bala包含nathonnatha/paksha/tribhaga/abda/masa/dina/hora/ayana及yuddha_bala（dict[str, float]）与war_pairs；shadbala_assessment（status=complete）汇总六力total_virupa、total_rupa、required_rupa、is_strong及ishta_kashta，并附12宫bhava_bala。",
    "cheshta_model": "cheshta_model默认simon1994_j2000（vedic_chart.strengths.cheshta_bala.method=simon1994_secular_mean），显式传unadjudicated时采用sidereal_angular_fallback。",
    "divisions": "divisions支持(2,3,4,7,9,10,12,16,20,24,27,30,40,45,60)共15种十六分盘（默认[9,10]），D1始终计算。D30不等长区段仅给星座及整宫（longitude/degree_in_sign为null）；任何分盘不套physical_state。",
    "ephemeris": "ephemeris_policy=auto|require_data_files；vedic_chart.profile.ephemeris_models、ephemeris_by_body与physical_ephemeris_source回显七个物理天体及Rahu/Ketu实际后端（平交点为swisseph_analytical_mean_node）；require_data_files拒绝七个物理天体的分析模型降级。",
    "full_export": "完整结果使用 include=[\"*\"]（默认省略次级细节路径见 run_metadata.omitted_fields），或按evidence_views（natal、strength、divisions）传入include/fields。",
    "physical_clock": "出生资料按民用钟物理瞬间（use_true_solar_time=False，preserve_instant=True）计算，不切换真太阳钟；vedic_chart.birth_time_sensitivity保留not_assessed摘要。",
    "physical_conditions": "vedic_chart.charts.D1.planets.*.physical_state含retrograde、speed_deg_per_day、baladi_avastha、degree_zone及combustion条件；不将combustion当作真实可见性或现实失能；D9/D10及其他分盘不套physical_state。dispositor_relationship为有方向的星体定位关系（from_planet/to_planet/natural/temporary/compound）。",
    "scope": "读取vedic_chart内独立Parashari规则（vedic_chart.ruleset_id），支持ayanamsa（lahiri/true_citra/raman/kp/true_pushya）与node_mode（mean/true），固定whole_sign整宫制；不把西占入庙或容许度套入印占。",
    "strength": "Sthana五分量用Virupa，60=1Rupa；saptavargaja_profile（santhanam_27/raman_30）与drekkana_profile（santhanam_27_6/raman_36）独立控制七分盘与三分盘力量表，见vedic_chart.profile与vedic_chart.strengths.sthana_bala；ashtakavarga_profile支持rao/aiyar。",
    "time_scales": "vedic_chart.profile.time_scale_context区分TT、模型UT1及future_leap_seconds_assumed_unchanged假设，并配合vedic_chart.profile.julian_day_utc/julian_day_tt/julian_day_ut解释。"
  },

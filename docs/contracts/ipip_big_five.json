{
  "evidence_views": {
    "items": {
      "fields": [
        "mode",
        "scale_id",
        "items",
        "item_count",
        "provenance"
      ],
      "scope": "action=list_items; Chinese glosses are project wording, not a validated adaptation."
    },
    "scores": {
      "fields": [
        "mode",
        "scale_id",
        "status",
        "domains",
        "answered_count",
        "missing_count",
        "provenance"
      ],
      "scope": "action=score; preserve per-domain insufficiency and the project 8/10 proration policy."
    }
  },
  "first_view": {
    "fields": [
      "mode",
      "scale_id",
      "provenance",
      "summary"
    ],
    "include_snapshot_text": false,
    "strict_fields": true
  },
  "input": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "default": "score",
        "description": "操作模式：list_items 列出50道标准IPIP题项与计分方向；score 对1-5分整数作答进行确定性正反向计分。",
        "enum": [
          "score",
          "list_items"
        ],
        "type": "string"
      },
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Freeze implicit current time: ISO 8601 datetime with timezone"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "domain": {
        "anyOf": [
          {
            "enum": [
              "extraversion",
              "agreeableness",
              "conscientiousness",
              "emotional_stability",
              "intellect"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅在 action=list_items 时可选筛选单个维度：extraversion / agreeableness / conscientiousness / emotional_stability / intellect。"
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "include_item_breakdown": {
        "default": false,
        "description": "仅在 action=score 时为 true 返回逐题原始分、计分键与折算后分值明细。",
        "type": "boolean"
      },
      "include_snapshot_text": {
        "default": false,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "ratings": {
        "anyOf": [
          {
            "items": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "按第1..50题顺序提交的1-5分整数列表（CLI支持 --ratings 5 1 4 ...）；缺题可设为 null，不可与 responses 同时提供；CLI列表含缺题时用 --subject-file JSON 或 --responses 保留题号，不可压缩题序。"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "responses": {
        "anyOf": [
          {
            "additionalProperties": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "按题号（'1'..'50'）映射的1-5分整数作答（JSON对象，CLI支持 --responses '{\"1\":5,...}'）；缺题可省略或设为 null，不可与 ratings 同时提供。"
      },
      "strict_fields": {
        "default": false,
        "description": "是否拒绝无效 fields 路径；默认 false，使用宽松投影并返回警告。",
        "type": "boolean"
      },
      "trace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Caller trace ID"
      }
    },
    "type": "object"
  },
  "method_contracts": [
    {
      "comparison_requirements": [
        "相同IPIP样本题序、50题键和项目8/10缺题策略"
      ],
      "dependencies": [
        "validated_request"
      ],
      "error_sources": [],
      "implementation_refs": [
        "src/fatebridge/core/psychometrics/ipip_big_five.py",
        "src/fatebridge/services/psychometrics.py"
      ],
      "limitations": [
        "8/10门槛为项目策略，IPIP原计分页未规定缺题处理",
        "中文为项目词义释义，未完成独立翻译效度研究",
        "未建立本产品常模或临床效度，不生成跨因子总分"
      ],
      "method_id": "fatebridge.ipip_big_five_50.contract_v1",
      "output_paths": [
        "mode",
        "scale_id",
        "domains",
        "items",
        "provenance"
      ],
      "prerequisites": [
        "list_items，或 score 提供至少一道1–5整数作答"
      ],
      "quantity_kind": "psychometric_domain_score",
      "role": "calculation",
      "selector_fields": [
        "action",
        "domain",
        "include_item_breakdown"
      ],
      "source_refs": [
        "https://ipip.ori.org/new_ipip-50-item-scale.htm",
        "https://ipip.ori.org/newScoringInstructions.htm"
      ],
      "unit": "likert_1_to_5",
      "validation_scope": {
        "numerical": "method_specific_reference_required",
        "real_world_validity": "not_established",
        "source_conformity": "item_keys_and_arithmetic_verified"
      }
    }
  ],
  "tool": "ipip_big_five"
}

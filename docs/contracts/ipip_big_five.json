  "input": {
    "additionalProperties": false,
    "description": "Shared request contract for administering or scoring IPIP Big-Five 50.",
    "properties": {
      "action": {
        "default": "score",
        "description": "操作模式：list_items 列出50道标准IPIP题项与计分方向；score 对1-5分整数作答进行确定性正反向计分。",
        "enum": [
          "score",
          "list_items"
        ],
        "title": "Action",
        "type": "string"
      },
      "domain": {
        "anyOf": [
          {
            "enum": [
              "extraversion",
              "agreeableness",
              "conscientiousness",
              "emotional_stability",
              "intellect"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅在 action=list_items 时可选筛选单个维度：extraversion / agreeableness / conscientiousness / emotional_stability / intellect。",
        "title": "Domain"
      },
      "include_item_breakdown": {
        "default": false,
        "description": "仅在 action=score 时为 true 返回逐题原始分、计分键与折算后分值明细。",
        "title": "Include Item Breakdown",
        "type": "boolean"
      },
      "ratings": {
        "anyOf": [
          {
            "items": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "按第1..50题顺序提交的1-5分整数列表（CLI支持 --ratings 5 1 4 ...）；缺题可设为 null，不可与 responses 同时提供。",
        "title": "Ratings"
      },
      "responses": {
        "anyOf": [
          {
            "additionalProperties": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "按题号（'1'..'50'）映射的1-5分整数作答（JSON对象，CLI支持 --responses '{\"1\":5,...}'）；缺题可省略或设为 null，不可与 ratings 同时提供。",
        "title": "Responses"
      }
    },
    "title": "IpipBigFiveRequest",
    "type": "object"
  },
  "method_contracts": [
    {
      "comparison_requirements": [
        "相同 Goldberg (1992) IPIP 50 题条目键、反向计分公式 (6 - score) 与 8/10 缺失阈值"
      ],
      "dependencies": [
        "validated_request"
      ],
      "error_sources": [],

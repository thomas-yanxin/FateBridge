{
  "call_guidance": {
    "delivery": "主层超预算时从 result_delivery 读取同一 run；投影后不能恢复首次未选字段。完整JSON首次 fields=null。",
    "marks": "Marks主层为marks_chart_pair，分别读marks_charts.inner/outer；chart仅为内方别名。每盘是本人与双方Davison资料再次计算Davison，沿实际davison_variant；不使用已撤除的组合／时空盘混合算法，不把个人象征盘当双方本命、真实心意或关系成功率。compatibility来自基础跨盘自定义规则，不能称为Marks原典评分。",
    "mode_aliases": "Comp→compare；Composite→composite；Synastry→influence；TimeSpace→timespace；Marks→marks；数值0..4依次对应这五种规范模式。",
    "views": "首次按已选 relative_mode 取 evidence_views 对应 fields；suggested_fields 是未选专用视图时的安全联合，不要求每次读取全部分支。核对实际 relationship_profile.relative_mode_normalized/primary_layer。"
  },
  "evidence_views": {
    "compare": {
      "aliases": [
        "compare",
        "comparison",
        "comp",
        "比较盘",
        "Comp",
        0
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "synastry_aspects",
        "in_to_out_aspects",
        "out_to_in_aspects"
      ],
      "primary_layer": "directional_synastry",
      "relative_mode": "compare",
      "when": "比较双方跨盘互动；按 A→B 与 B→A 分开读"
    },
    "composite": {
      "aliases": [
        "组合盘",
        "composite",
        "Composite",
        1
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "chart"
      ],
      "primary_layer": "composite_chart",
      "relative_mode": "composite",
      "when": "用户指定组合盘，解释合成关系结构"
    },
    "data_files": {
      "fields": [
        "ephemeris_data_policy"
      ],
      "scope": "Available when ephemeris_policy=require_data_files. Read the actual observed physical models, file hashes, reference zeros and private-worker reports. Native event-internal reads, fixed-star catalogue formulae and absolute accuracy are not certified. This card does not set the input policy."
    },
    "influence": {
      "aliases": [
        "influence",
        "synastry",
        "影响盘",
        "Synastry",
        2
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "inner.chart_profile",
        "inner.chart.angles",
        "inner.chart.houses",
        "inner.chart.planets",
        "outer.chart_profile",
        "outer.chart.angles",
        "outer.chart.houses",
        "outer.chart.planets"
      ],
      "primary_layer": "influence_chart_pair",
      "relative_mode": "influence",
      "when": "用户指定影响盘／Synastry，分别读双方视角；inner/outer不是各自本命"
    },
    "marks": {
      "aliases": [
        "marks",
        "马克斯盘",
        "Marks",
        4
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "marks_charts"
      ],
      "primary_layer": "marks_chart_pair",
      "relative_mode": "marks",
      "when": "用户指定马克斯盘；分别读取内方与外方个人盘，chart只是内方别名"
    },
    "relationship_detail": {
      "fields": [
        "relationship_profile",
        "in_to_out_midpoint",
        "out_to_in_midpoint",
        "in_to_out_antiscia",
        "out_to_in_antiscia",
        "in_to_out_contra_antiscia",
        "out_to_in_contra_antiscia"
      ],
      "when": "明确问双向中点、映点或反映点；将所需字段加入所选模式主层，不替代主盘"
    },
    "timespace": {
      "aliases": [
        "timespace",
        "time space",
        "时空中点盘",
        "TimeSpace",
        3
      ],
      "fields": [
        "relationship_profile",
        "summary",
        "chart"
      ],
      "primary_layer": "timespace_chart",
      "relative_mode": "timespace",
      "when": "用户指定时空中点盘"
    }
  },
  "first_view": {
    "fields": [
      "relationship_profile",
      "summary",
      "compatibility",
      "synastry_aspects",
      "in_to_out_aspects",
      "out_to_in_aspects",
      "chart",
      "marks_charts",
      "inner.chart_profile",
      "inner.chart.angles",
      "inner.chart.houses",
      "inner.chart.planets",
      "outer.chart_profile",
      "outer.chart.angles",
      "outer.chart.houses",
      "outer.chart.planets"
    ],
    "include_snapshot_text": false,
    "strict_fields": true
  },
  "input": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Freeze implicit current time: ISO 8601 datetime with timezone"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "davison_variant": {
        "default": "uncorrected",
        "description": "TimeSpace/Marks variant: uncorrected, MC-axis corrected, or spherical geographic midpoint. UT1 arithmetic time mean; nondefault variants require TimeSpace or Marks.",
        "enum": [
          "uncorrected",
          "corrected",
          "spherical"
        ],
        "type": "string"
      },
      "ephemeris_policy": {
        "default": "auto",
        "description": "auto retains and reports actual available models. require_data_files rejects analytical/orbital fallback for observed physical coordinates throughout the request, including clocks and samples; checks data contexts and endpoint hashes. Native rise/set query/result epochs are probed, but internal solver reads are not fully observable. Analytical points, fictitious elements, reference zeros and Earth rotation are separate; this is not an astronomical-accuracy or prediction certificate.",
        "enum": [
          "auto",
          "require_data_files"
        ],
        "type": "string",
        "x-fatebridge-western-data-policy": true
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "hsys": {
        "default": 3,
        "description": "House system identifier (0..8). Defaults to Placidus (3) to match the natal chart. Explicit values must be integer codes0..8; boolean, floating-point, blank and out-of-range values are rejected.",
        "maximum": 8,
        "minimum": 0,
        "type": "integer"
      },
      "include_snapshot_text": {
        "default": true,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "inner_birth_day": {
        "description": "Inner chart birth day",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "inner_birth_hour": {
        "description": "Inner chart birth hour",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "inner_birth_latitude": {
        "description": "Inner latitude",
        "maximum": 90,
        "minimum": -90,
        "type": "number"
      },
      "inner_birth_longitude": {
        "description": "Inner longitude",
        "maximum": 180,
        "minimum": -180,
        "type": "number"
      },
      "inner_birth_minute": {
        "default": 0,
        "description": "Inner birth minute",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      },
      "inner_birth_month": {
        "description": "Inner chart birth month",
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
      },
      "inner_birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Inner birth place"
      },
      "inner_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Inner timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from supported inner_birth_place; no implicit UTC is selected when unresolved. A hardcoded 'UTC' default silently treated an eastern wall-clock time as UTC and rotated the chart."
      },
      "inner_birth_year": {
        "description": "Inner chart birth year",
        "type": "integer"
      },
      "inner_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "内盘",
        "description": "Inner chart name"
      },
      "inner_use_true_solar_time": {
        "default": false,
        "description": "Use apparent solar time for the inner chart",
        "type": "boolean"
      },
      "outer_birth_day": {
        "description": "Outer chart birth day",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "outer_birth_hour": {
        "description": "Outer chart birth hour",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "outer_birth_latitude": {
        "description": "Outer latitude",
        "maximum": 90,
        "minimum": -90,
        "type": "number"
      },
      "outer_birth_longitude": {
        "description": "Outer longitude",
        "maximum": 180,
        "minimum": -180,
        "type": "number"
      },
      "outer_birth_minute": {
        "default": 0,
        "description": "Outer birth minute",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      },
      "outer_birth_month": {
        "description": "Outer chart birth month",
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
      },
      "outer_birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Outer birth place"
      },
      "outer_birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Outer timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from supported outer_birth_place; no implicit UTC is selected when unresolved. A hardcoded 'UTC' default silently treated an eastern wall-clock time as UTC and rotated the chart."
      },
      "outer_birth_year": {
        "description": "Outer chart birth year",
        "type": "integer"
      },
      "outer_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "外盘",
        "description": "Outer chart name"
      },
      "outer_use_true_solar_time": {
        "default": false,
        "description": "Use apparent solar time for the outer chart",
        "type": "boolean"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "relationship_focus": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional relationship intent lens: marriage/婚姻 or romance/恋爱; adds a focus block + intent-filtered synastry aspects. Default/unset is general (no filtering)."
      },
      "relative_mode": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Relative mode selector"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "strict_fields": {
        "default": false,
        "description": "是否拒绝无效 fields 路径；默认 false，使用宽松投影并返回警告。",
        "type": "boolean"
      },
      "trace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Caller trace ID"
      },
      "zodiacal": {
        "default": 0,
        "description": "Zodiac selector",
        "type": "integer"
      }
    },
    "required": [
      "inner_birth_year",
      "inner_birth_month",
      "inner_birth_day",
      "inner_birth_hour",
      "inner_birth_longitude",
      "inner_birth_latitude",
      "outer_birth_year",
      "outer_birth_month",
      "outer_birth_day",
      "outer_birth_hour",
      "outer_birth_longitude",
      "outer_birth_latitude"
    ],
    "type": "object"
  },

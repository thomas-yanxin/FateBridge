  "input": {
    "additionalProperties": false,
    "description": "Request model for aggregate western predictive timing analysis.",
    "properties": {
      "analysis_day": {
        "anyOf": [
          {
            "maximum": 31,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis day (1-31)",
        "title": "Analysis Day"
      },
      "analysis_hour": {
        "anyOf": [
          {
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis hour (0-23)",
        "title": "Analysis Hour"
      },
      "analysis_minute": {
        "anyOf": [
          {
            "maximum": 59,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis minute (0-59)",
        "title": "Analysis Minute"
      },
      "analysis_month": {
        "anyOf": [
          {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis month (1-12)",
        "title": "Analysis Month"
      },
      "analysis_year": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis year",
        "title": "Analysis Year"
      },
      "birth_day": {
        "description": "Birth day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "title": "Birth Day",
        "type": "integer"
      },
      "birth_hour": {
        "description": "Birth hour (0-23)",
        "maximum": 23,
        "minimum": 0,
        "title": "Birth Hour",
        "type": "integer"
      },
      "birth_latitude": {
        "anyOf": [
          {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth latitude (optional when birth_place is given)",
        "title": "Birth Latitude"
      },
      "birth_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth longitude (optional when birth_place is given)",
        "title": "Birth Longitude"
      },
      "birth_minute": {
        "default": 0,
        "description": "Birth minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "title": "Birth Minute",
        "type": "integer"
      },
      "birth_month": {
        "description": "Birth month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "title": "Birth Month",
        "type": "integer"
      },
      "birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth place (optional; when coordinates/timezone are omitted, resolved lazily via supported city catalog)",
        "title": "Birth Place"
      },
      "birth_second": {
        "anyOf": [
          {
            "maximum": 59,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "出生秒数（0-59，可选，用于跨工具参数对称）。",
        "title": "Birth Second"
      },
      "birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth timezone (IANA name or UTC offset). Optional: when omitted, FateBridge may resolve it from a supported birth_place. Western charts and timing reject an unresolved civil timezone; coordinates alone do not establish a zone. Supply UTC explicitly when that is the confirmed recorded basis. Place inference does not certify historical clock accuracy.",
        "title": "Birth Timezone"
      },
      "birth_utc_offset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "已确认的出生民用UTC偏移（±HH:MM或±HH:MM:SS，可选，用于跨工具参数对称）。",
        "title": "Birth Utc Offset"
      },
      "birth_year": {
        "description": "Birth year, e.g., 1990",
        "maximum": 9999,
        "minimum": 1,
        "title": "Birth Year",
        "type": "integer"
      },
      "firdaria_night_order": {
        "default": "nodes_at_end",
        "description": "Firdaria night order: nodes_at_end (existing default, after Mercury) or nodes_after_mars (Bonatti-labelled variant). Day order is unchanged.",
        "enum": [
          "nodes_at_end",
          "nodes_after_mars"
        ],
        "title": "Firdaria Night Order",
        "type": "string"
      },
      "firdaria_year_basis": {
        "default": "fixed_365_2425",
        "description": "Firdaria year basis: fixed_365_2425 (fixed 86400-second days on UTC elapsed time) or calendar_anniversary (original-birth anniversaries, Feb 29 clamps to Feb 28 then restores; UTC elapsed subperiods). Calendar mode rejects ambiguous/nonexistent birth, analysis and generated anniversary clocks.",
        "enum": [
          "fixed_365_2425",
          "calendar_anniversary"
        ],
        "title": "Firdaria Year Basis",
        "type": "string"
      },
      "gender": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "性别（可选，用于批量/跨工具参数对称；西方推运计算不使用性别）。",
        "title": "Gender"
      },
      "high_latitude_fallback": {
        "default": "error",
        "description": "Fallback when quadrant houses fail at high latitudes: error (default), porphyry, or whole_sign.",
        "enum": [
          "error",
          "porphyry",
          "whole_sign"
        ],
        "title": "High Latitude Fallback",
        "type": "string"
      },
      "house_system": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "default": "P",
        "description": "House system, any convention: SE letter ('P'=Placidus, 'R'=Regiomontanus, 'W'=whole sign, 'D'=equal_mc), key ('placidus', 'equal_mc'), or integer code 0..8 (3=Placidus, 8=equal_mc). Explicit values must be supported letters/names or integer codes0..8; unknown, blank, boolean and floating-point selections are rejected without substitution. Gauquelin (G) has36 clockwise sectors and is unavailable here.",
        "title": "House System"
      },
      "include_full_timelines": {
        "default": false,
        "description": "Whether to include full multi-decade timelines; default False returns active states and bounded nearby windows.",
        "title": "Include Full Timelines",
        "type": "boolean"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Name (optional)",
        "title": "Name"
      },
      "pd_aspects": {
        "description": "Primary direction aspects in degrees",
        "items": {
          "type": "integer"
        },
        "title": "Pd Aspects",
        "type": "array"
      },
      "pd_direction_mode": {
        "default": "zodiacal",
        "description": "Primary direction mode: 'zodiacal' (ecliptic aspect points) or 'mundane' (in mundo).",
        "enum": [
          "zodiacal",
          "mundane"
        ],
        "title": "Pd Direction Mode",
        "type": "string"
      },
      "pd_method": {
        "default": "placidus",
        "description": "Primary direction method: placidus (default), regiomontanus, campanus, alcabitius, or equatorial (oblique ascension for Asc, RAMC for MC).",
        "enum": [
          "placidus",
          "regiomontanus",
          "campanus",
          "alcabitius",
          "equatorial",
          "astroapp_alchabitius",
          "fatebridge_mundane_semiarc"
        ],
        "title": "Pd Method",
        "type": "string"
      },
      "pd_time_key": {
        "default": "Ptolemy",
        "description": "Primary direction time key: Ptolemy, Naibod, Cardan, Solar_Arc, or Van_Dam.",
        "enum": [
          "Ptolemy",
          "Naibod",
          "Cardan",
          "Solar_Arc",
          "Van_Dam"
        ],
        "title": "Pd Time Key",
        "type": "string"
      },
      "pd_type": {
        "default": 0,
        "description": "Primary direction mode: 0 for direct, 1 for converse",
        "maximum": 1,
        "minimum": 0,
        "title": "Pd Type",
        "type": "integer"
      },
      "return_latitude": {
        "anyOf": [
          {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Return chart latitude",
        "title": "Return Latitude"
      },
      "return_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Return chart longitude",
        "title": "Return Longitude"
      },
      "return_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Return chart timezone (IANA name or UTC offset)",
        "title": "Return Timezone"
      },
      "show_pd_bounds": {
        "default": true,
        "description": "Whether to expose the bounds overlay preference for the primary direction chart",
        "title": "Show Pd Bounds",
        "type": "boolean"
      },
      "techniques": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "firdaria",
                "profection",
                "solar_return",
                "lunar_return",
                "transit",
                "given_year",
                "secondary_progression",
                "solar_arc",
                "primary_directions",
                "primary_direction_chart",
                "decennials",
                "zodiacal_releasing"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional subset of western timing techniques to compute; when omitted, computes all techniques.",
        "title": "Techniques"
      },
      "zodiac_type": {
        "default": "Tropic",
        "description": "Zodiac type: Tropic or Sidereal",
        "enum": [
          "Tropic",
          "Sidereal"
        ],
        "title": "Zodiac Type",
        "type": "string"
      }
    },
    "required": [
      "birth_year",
      "birth_month",
      "birth_day",
      "birth_hour"
    ],
    "title": "WesternTimingRequest",
    "type": "object"
  },
  "tool": "western_timing"
}

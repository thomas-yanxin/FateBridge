{
  "call_guidance": {
    "clock_defaults": "分析日期全省略时用 as_of/执行开始的完整当地瞬间；实际时刻与补齐来源见 analysis_context。"
  },
  "default_omit": [
    "calendar_context",
    "interaction_analysis",
    "combined_effects",
    "dayun.timing_context",
    "dayun.element_effects",
    "dayun.natal_relations",
    "dayun.shensha",
    "liunian.element_effects",
    "liuyue.detailed_analysis",
    "liuri.detailed_analysis",
    "liushi.detailed_analysis",
    "analysis_calendar.analysis_date_context.current_solar_term.civil_point",
    "analysis_calendar.analysis_date_context.current_solar_term.comparison_policy",
    "analysis_calendar.analysis_date_context.next_solar_term.civil_point",
    "analysis_calendar.analysis_date_context.next_solar_term.comparison_policy",
    "analysis_calendar.analysis_date_context.bazi_month_boundary.start_term.civil_point",
    "analysis_calendar.analysis_date_context.bazi_month_boundary.start_term.comparison_policy",
    "analysis_calendar.analysis_date_context.bazi_month_boundary.next_term.civil_point",
    "analysis_calendar.analysis_date_context.bazi_month_boundary.next_term.comparison_policy",
    "analysis_calendar.analysis_date_context.lunar_calendar.previous_jieqi",
    "analysis_calendar.analysis_date_context.lunar_calendar.next_jieqi",
    "analysis_calendar.analysis_year_jieqi.*.civil_point",
    "analysis_calendar.analysis_year_jieqi.*.comparison_policy",
    "analysis_calendar.liuyue_timeline.*.start_term.civil_point",
    "analysis_calendar.liuyue_timeline.*.start_term.comparison_policy",
    "analysis_calendar.liuyue_timeline.*.next_term.civil_point",
    "analysis_calendar.liuyue_timeline.*.next_term.comparison_policy",
    "analysis_calendar.jieqi_timeline.*.jieqi.civil_point",
    "analysis_calendar.jieqi_timeline.*.jieqi.comparison_policy"
  ],
  "evidence_views": {
    "analysis_clock": {
      "fields": [
        "analysis_context"
      ],
      "when": "核对同次完整分析瞬间、UTC偏移/fold及分析日期的补齐来源；不把默认月初、月中或整点当成当前。"
    },
    "birth_time_sensitivity": {
      "fields": [
        "person_info.analysis_datetime",
        "calendar_context.birth_time_input",
        "dayun"
      ],
      "when": "用户确认名义出生参考的正负UTC经过分钟范围时，传birth_time_uncertainty_minutes并读取完整候选与事件未决层；无分钟样本的事件候选不能忽略，计数不是概率，None不是精确生时"
    },
    "carriers": {
      "fields": [
        "person_info.analysis_datetime"
      ],
      "when": "核对大运至流时的同柱干支生克、本柱真实藏根及原局外援；喜支才核盖头、喜干才核截脚压力，不据候选裁定喜忌、合化、救应或吉凶。"
    },
    "carriers_detail": {
      "fields": [
        "person_info.analysis_datetime"
      ],
      "when": "逐项核对本柱藏根和原局外援及原典来源；完整明细若分页，读取同一run，不另算补齐。"
    },
    "dayun_timeline": {
      "fields": [
        "person_info.analysis_datetime",
        "dayun"
      ],
      "when": "查看交运边界与十二步大运时间轴；analysis_age仅作显式年龄参考，默认按目标时刻选运"
    },
    "interactions": {
      "fields": [
        "person_info.analysis_datetime",
        "dayun",
        "liunian",
        "liuyue",
        "interaction_analysis"
      ],
      "when": "核对原局、大运至流时之间的结构关系；关系成立不代表合化或吉凶，按所问时间层筛选"
    },
    "root_effects": {
      "fields": [
        "person_info.analysis_datetime",
        "interaction_analysis.nodes",
        "interaction_analysis.relations"
      ],
      "when": "核对时间支冲刑及唯一大运干五合对原局既有预算的限定投影、来源、同次参数与阻塞关系；其它时间粒度的干合未定量，残存原局数值档不能解释为完整行运后旺衰。"
    },
    "roots": {
      "fields": [
        "person_info.analysis_datetime",
        "interaction_analysis.nodes",
        "interaction_analysis.relations"
      ],
      "when": "核对日主在时运支的原典根类、真实藏干及同次冲合刑触点；月令仍属原局，阴长生参考不补根，未见根不直接判弱，关系触点不等于有效损益。"
    },
    "stem_roots": {
      "fields": [
        "person_info.analysis_datetime",
        "interaction_analysis.nodes",
        "interaction_analysis.relations"
      ],
      "when": "核对运干在四个原局支的根类及关系触点；共享根位不能重复相加为预算，不据原局根存在宣称已算行运后旺衰。"
    }
  },
  "first_view": {
    "fields": [
      "person_info.analysis_datetime",
      "four_pillars",
      "dayun.current_dayun",
      "dayun.start_at",
      "dayun.end_at",
      "dayun.selection_basis",
      "liunian.pillar",
      "liunian.year",
      "liunian.year_boundary_policy",
      "liunian.year_boundary_basis",
      "liuyue.pillar",
      "liuri.pillar",
      "liushi.pillar",
      "analysis_calendar.analysis_date_context.timezone",
      "analysis_calendar.analysis_date_context.current_solar_term.name",
      "analysis_calendar.analysis_date_context.current_solar_term.datetime_with_offset",
      "analysis_calendar.analysis_date_context.next_solar_term.name",
      "analysis_calendar.analysis_date_context.next_solar_term.datetime_with_offset",
      "analysis_calendar.analysis_date_context.bazi_month_boundary.branch"
    ]
  },
  "input": {
    "additionalProperties": false,
    "description": "Request model for comprehensive timing analysis.",
    "properties": {
      "analysis_age": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis age override",
        "title": "Analysis Age"
      },
      "analysis_day": {
        "anyOf": [
          {
            "maximum": 31,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis day (1-31)",
        "title": "Analysis Day"
      },
      "analysis_hour": {
        "anyOf": [
          {
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis hour (0-23)",
        "title": "Analysis Hour"
      },
      "analysis_minute": {
        "anyOf": [
          {
            "maximum": 59,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis minute (0-59)",
        "title": "Analysis Minute"
      },
      "analysis_month": {
        "anyOf": [
          {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis month (1-12)",
        "title": "Analysis Month"
      },
      "analysis_year": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "完全省略全部analysis_*日期分量时，使用本次as_of或执行开始时刻的完整当地瞬间；提供任一日期分量时沿用部分日期规则：缺年/月取当前年/月，缺日取1、缺时分取0。 显式日期的不存在或重复钟时须用有效钟时或明确UTC偏移消歧。",
        "title": "Analysis Year"
      },
      "birth_day": {
        "description": "Birth day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "title": "Birth Day",
        "type": "integer"
      },
      "birth_hour": {
        "anyOf": [
          {
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth hour (0-23); omit only when birth_time_unknown=True",
        "title": "Birth Hour"
      },
      "birth_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth longitude (optional)",
        "title": "Birth Longitude"
      },
      "birth_minute": {
        "default": 0,
        "description": "Birth minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "title": "Birth Minute",
        "type": "integer"
      },
      "birth_month": {
        "description": "Birth month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "title": "Birth Month",
        "type": "integer"
      },
      "birth_place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "Birth place (optional)",
        "title": "Birth Place"
      },
      "birth_second": {
        "anyOf": [
          {
            "maximum": 59,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "已知出生秒数0–59；提供时必须显式提供birth_minute。未知请省略或传null；沿用00秒作为兼容计算参考，并返回省略分量说明，不代表已知出生在整分、不推定误差区间或记录精度。不接受闰秒60。",
        "title": "Birth Second"
      },
      "birth_time_uncertainty_minutes": {
        "anyOf": [
          {
            "maximum": 120,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅传用户确认的名义出生参考正负UTC经过分钟范围；保留分钟网格，并补充计算节令、钟面、大运名义月进位与当前分析日附近未来跳时逆像探针。未认证全部连续交运状态或极值。None表示未提供范围，不表示精确生时。",
        "title": "Birth Time Uncertainty Minutes"
      },
      "birth_time_unknown": {
        "default": false,
        "description": "明确声明出生时辰未知；仅在为 true 时允许省略 birth_hour，按三柱/日级口径推算并标注边界提示",
        "title": "Birth Time Unknown",
        "type": "boolean"
      },
      "birth_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Birth timezone (IANA name or UTC offset)",
        "title": "Birth Timezone"
      },
      "birth_utc_offset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "已确认的出生民用UTC偏移，格式±HH:MM或±HH:MM:SS；用于消歧重复钟时。必须与解析出的birth_timezone在该钟时的规则一致；不据此猜测时区，不替未知的重复小时选边，不能使跳过的钟时有效。保留原IANA时区用于后续交运边界；不认证出生记录精度。未知请省略或传null。",
        "title": "Birth Utc Offset"
      },
      "birth_year": {
        "description": "Birth year (1900–2100, the existing individual-birth service range)",
        "maximum": 2100,
        "minimum": 1900,
        "title": "Birth Year",
        "type": "integer"
      },
      "changsheng_school": {
        "default": "fire_earth_same_palace",
        "description": "十二长生流派：fire_earth_same_palace（火土同宫，戊随丙、己随丁） | water_earth_same_palace（水土同宫，戊随壬、己随癸） | five_element_same_stage（五行同生同死）。",
        "enum": [
          "fire_earth_same_palace",
          "water_earth_same_palace",
          "five_element_same_stage"
        ],
        "title": "Changsheng School",
        "type": "string"
      },
      "duty_profile": {
        "default": "sanming",
        "description": "人元司令分野分日表：sanming（三命通会）| yuanhai（渊海子平）| 6tail | ditian（滴天髓）。",
        "enum": [
          "sanming",
          "yuanhai",
          "6tail",
          "ditian"
        ],
        "title": "Duty Profile",
        "type": "string"
      },
      "gender": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未知",
        "description": "性别（可选但建议提供：影响大运顺逆排布与部分六亲判断）。接受 男/女、male/female/m/f、阳/阴、乾/坤 等写法。",
        "title": "Gender"
      },
      "include_timelines": {
        "default": false,
        "description": "是否同时返回分析年的二十四节气网格、十二节流月时间轴与节气节点时间轴。",
        "title": "Include Timelines",
        "type": "boolean"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "未提供",
        "description": "姓名（可选，仅用于结果标识，不参与计算）",
        "title": "Name"
      },
      "use_true_solar_time": {
        "default": true,
        "description": "Rebase the birth clock onto true solar time (longitude + equation of time). Default on in the current software policy; this option does not certify a classical text's clock rule. Set false for the raw civil clock.",
        "title": "Use True Solar Time",
        "type": "boolean"
      },
      "year_boundary_policy": {
        "default": "lichun",
        "description": "年柱换年口径：lichun（默认，立春换年；提供月份/日期时按立春精确时刻判断，仅传analysis_year时视为该太阳年）或 gregorian（按公历整数年份）。",
        "enum": [
          "lichun",
          "gregorian"
        ],
        "title": "Year Boundary Policy",
        "type": "string"
      },
      "zi_hour_policy": {
        "default": "day_rollover_at_23",
        "description": "早晚子时（23:00–23:59）流派：day_rollover_at_23（sect=1，23时换日柱，五鼠遁按次日干） | night_zi_same_day_next_hour_stem（sect=2，夜子时日柱不换，时干按次日五鼠遁） | night_zi_same_day_same_hour_stem（夜子时日柱不换，时干按当日五鼠遁）。",
        "enum": [
          "day_rollover_at_23",
          "night_zi_same_day_next_hour_stem",
          "night_zi_same_day_same_hour_stem"
        ],
        "title": "Zi Hour Policy",
        "type": "string"
      }
    },
    "required": [
      "birth_year",
      "birth_month",
      "birth_day"
    ],
    "title": "TimingAnalysisRequest",
    "type": "object"
  },
  "tool": "bazi_timing"
}

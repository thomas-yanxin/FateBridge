{
  "evidence_views": {
    "focus_and_timing": {
      "fields": [
        "analysis_context",
        "nongli",
        "moving_lines",
        "hexagram_info",
        "liuyao_evidence.focus",
        "liuyao_evidence.lines",
        "liuyao_evidence.moving_focus_guidance",
        "liuyao_evidence.timing_candidates",
        "summary"
      ],
      "when": "已指定 focus_line/focus_kinship/focus_kind 及可选 timing_days 时，核对用神取用、生克角色（roles）、动静焦点引导与日级条件窗口；日级条件窗口不是事件发生保证"
    },
    "line_reading": {
      "fields": [
        "analysis_context",
        "nongli",
        "current_hexagram",
        "changed_hexagram",
        "moving_lines",
        "lines",
        "hexagram_info",
        "liuyao_evidence",
        "summary"
      ],
      "when": "读取逐爻纳支、世应、六亲六神与 zengshan_structural_v2 结构证据；focus_line/focus_kinship 为明确取用前提，日级候选不等于事件应期"
    },
    "structural_relations": {
      "fields": [
        "analysis_context",
        "nongli",
        "lines",
        "hexagram_info.gua_shen",
        "patterns",
        "pattern_flags",
        "liuyao_evidence.lines",
        "liuyao_evidence.hidden_spirits",
        "liuyao_evidence.hidden_policy",
        "liuyao_evidence.three_harmony",
        "liuyao_evidence.fanfu",
        "liuyao_evidence.shensha",
        "summary"
      ],
      "when": "细查伏神、三合局、反吟伏吟与六冲六合格局及神煞时使用；伏神按本卦缺失六亲取本宫纯卦同位，不因变爻掩盖"
    }
  },
  "first_view": {
    "fields": [
      "analysis_context",
      "nongli",
      "current_hexagram",
      "changed_hexagram",
      "moving_lines",
      "lines",
      "hexagram_info",
      "liuyao_evidence",
      "summary"
    ]
  },
  "input": {
    "$defs": {
      "SixYaoLineRequest": {
        "additionalProperties": false,
        "description": "One six-yao line item.",
        "properties": {
          "change": {
            "default": false,
            "description": "Whether the line is moving",
            "title": "Change",
            "type": "boolean"
          },
          "god": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional six-god label",
            "title": "God"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional line label",
            "title": "Name"
          },
          "value": {
            "description": "0 for yin, 1 for yang",
            "maximum": 1,
            "minimum": 0,
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "title": "SixYaoLineRequest",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Request model for sixyao.",
    "properties": {
      "changed_code": {
        "anyOf": [
          {
            "pattern": "^[01]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Changed hexagram code, initial line first",
        "title": "Changed Code"
      },
      "coins": {
        "anyOf": [
          {
            "items": {
              "maximum": 9,
              "minimum": 6,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "摇钱起卦六掷之和（初爻→上爻），每掷为三枚铜钱之和 6/7/8/9（字面=2、背面=3）。提供则按真实摇出的铜钱结果装卦。",
        "title": "Coins"
      },
      "date": {
        "description": "Date string, e.g. 2028-04-06",
        "title": "Date",
        "type": "string"
      },
      "focus_kind": {
        "anyOf": [
          {
            "enum": [
              "visible",
              "changed",
              "hidden",
              "month",
              "day"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "明确取本爻visible、实际变爻changed、已列伏神hidden、月建month或日辰day；日月不带爻位，未指定时保留本变候选",
        "title": "Focus Kind"
      },
      "focus_kinship": {
        "anyOf": [
          {
            "enum": [
              "父母",
              "兄弟",
              "子孙",
              "妻财",
              "官鬼"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "明确选用的六亲；多现保留候选，与focus_line并用时须一致",
        "title": "Focus Kinship"
      },
      "focus_line": {
        "anyOf": [
          {
            "maximum": 6,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "调用方明确选定的用神爻位，初爻为1；默认取本爻，focus_kind可选变爻或已列伏神",
        "title": "Focus Line"
      },
      "gua_code": {
        "anyOf": [
          {
            "pattern": "^[01]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Current hexagram code, initial line first",
        "title": "Gua Code"
      },
      "latitude": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "31n13",
        "description": "Latitude text or decimal",
        "title": "Latitude"
      },
      "lines": {
        "description": "Optional six lines, initial line first",
        "items": {
          "$ref": "#/$defs/SixYaoLineRequest"
        },
        "maxItems": 6,
        "title": "Lines",
        "type": "array"
      },
      "longitude": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "121e28",
        "description": "Longitude text or decimal",
        "title": "Longitude"
      },
      "method": {
        "default": "auto",
        "description": "起卦方式：auto（默认，缺卦则按时刻时间起卦）/ coin（真·摇钱起卦，系统随机六掷）/ time（时间起卦）。提供 coins/lines/gua_code 时优先使用所提供的卦，重复输入必须一致。",
        "enum": [
          "auto",
          "coin",
          "time"
        ],
        "title": "Method",
        "type": "string"
      },
      "place": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "地点名称（支持离线地名库自动补全 longitude / latitude / timezone）",
        "title": "Place"
      },
      "question": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Question or topic",
        "title": "Question"
      },
      "seed": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "随机摇钱起卦的随机种子（method=coin 且未提供 coins 时），用于复现同一卦。",
        "title": "Seed"
      },
      "time": {
        "description": "Time string, e.g. 09:33:00",
        "title": "Time",
        "type": "string"
      },
      "timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "+08:00",
        "description": "Timezone spec",
        "title": "Timezone"
      },
      "timing_days": {
        "default": 0,
        "description": "按已明确的用爻列未来0至60个干支日的条件候选；0不展开，不是事件发生保证",
        "maximum": 60,
        "minimum": 0,
        "title": "Timing Days",
        "type": "integer"
      }
    },
    "required": [
      "date",
      "time"
    ],
    "title": "SixYaoRequest",
    "type": "object"
  },
  "tool": "liuyao"
}

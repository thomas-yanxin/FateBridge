{
  "call_guidance": {
    "birth_choice": "birth_date、birth_at、birth_year最多传一个，不能同时传日期和时刻",
    "natal_delivery": "询问玄空宅盘时确认已选 xuankong_natal（可用 methods 显式选中）。通用 first_view 用于已执行布局分析；宅盘首读用 evidence_views.natal_candidates 取历史定运、朝向、全部候选、待补事实和来源。缺磁向用 house.facing_degrees 或 xuankong.house.facing_degrees 配同一 house 的 north_reference=magnetic。",
    "natal_interpretation": "玄空有限解释需 xuankong.interpretation 显式启用 xuankong_conditioned_v1；当前评价运 current_period_number 与 period_evidence 成对，不改历史宅运。external_forms 按全宅中心八宫独立确认外部山形/水形，未知省略，照片保留候选，不复用金锁砂水或室内靠背；床/门取用结合顶层 placements.location_direction，桌/灶未覆盖。",
    "natal_projection": "同次需要的视图在首轮合并 fields，或用 include 按需追加路径/视图。兼容原始路径 layers.xuankong_natal.chart 只有唯一候选才有值；完整导出使用 include=[\"*\"]。"
  },
  "default_omit": [
    "conflicts",
    "layers.bazhai.house.sitting_bearing",
    "layers.bazhai.house.sectors",
    "layers.bazhai.house_candidates.*.sectors",
    "layers.bazhai.occupants.*.time_context.timing",
    "layers.bazhai.occupants.*.candidates.*.sectors",
    "layers.bazhai.placement_findings",
    "layers.jinsuo.twenty_four_mountains",
    "layers.jinsuo.feature_findings",
    "layers.annual_stars.time_context.timing",
    "layers.annual_stars.palaces",
    "layers.annual_stars.flight_path",
    "layers.monthly_stars.time_context.timing",
    "layers.monthly_stars.palaces",
    "layers.monthly_stars.flight_path",
    "layers.monthly_stars.daily_stars.palaces",
    "layers.monthly_stars.hourly_stars.palaces",
    "layers.xuankong_natal.period_context.timing",
    "layers.xuankong_natal.chart.flight_details",
    "layers.xuankong_natal.chart.structure.classical_patterns",
    "layers.xuankong_natal.chart.structure.combination_of_ten",
    "layers.xuankong_natal.candidates.*.flight_details",
    "layers.xuankong_natal.candidates.*.structure.classical_patterns",
    "layers.xuankong_natal.candidates.*.structure.combination_of_ten",
    "layers.xuankong_natal.interpretation.candidates.*.palaces",
    "layout_analysis.adjustment_options",
    "layout_analysis.element_relationships"
  ],
  "evidence_views": {
    "natal_candidates": {
      "fields": [
        "status",
        "layers.xuankong_natal.status",
        "layers.xuankong_natal.period_context",
        "layers.xuankong_natal.orientation_context",
        "layers.xuankong_natal.candidates",
        "layers.xuankong_natal.missing_inputs"
      ],
      "purpose": "玄空宅盘候选星盘与定运朝向依据",
      "when": "传入 built_year 且 methods 包含 xuankong_natal 时"
    },
    "natal_patterns": {
      "fields": [
        "status",
        "layers.xuankong_natal.status",
        "layers.xuankong_natal.period_context",
        "layers.xuankong_natal.orientation_context",
        "layers.xuankong_natal.chart",
        "layers.xuankong_natal.candidates",
        "layers.xuankong_natal.missing_inputs"
      ],
      "purpose": "玄空宅盘格局与挨星盘面",
      "when": "传入 built_year 且 methods 包含 xuankong_natal 时"
    }
  },
  "first_view": {
    "fields": [
      "status",
      "layers",
      "palace_overlay",
      "layout_analysis",
      "coverage"
    ]
  },

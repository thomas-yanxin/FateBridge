{
  "call_guidance": {
    "birth_choice": "birth_date、birth_at、effective_birth_year最多传一个，不能同时传日期和时刻",
    "environmental_context": "environmental_context提供独立环境/家庭/楼层事实，不传八字紫微喜忌；首轮fields追加layout_analysis.environmental_context。orientation分别确认direction_confirmed、north_reference、floorplan_alignment_confirmed、center_confirmed；未确认落宫不能同时传位置/砂水/外局分宫，仍可原始盘与独立形态。",
    "feasibility": "feasible_zones只含用户逐区明确确认能容纳对象并保持视野的区域，不从照片空白、物件属性确认或允许移动扩展；其余省略",
    "interior_relations": "明确非罗盘关系用environmental_context.interior_relations：relation_id/source_object_id/target_object_id/kind/present/observation_basis/evidence；present必须显式true、false或null，照片true/false均候选，不由相邻/可见推直接相对。",
    "interpretation": "先解释已有依据，再给条件式建议；照片候选不升级事实，但不等待全部complete或动作ready才解释。analysis_progress.interpretation_status区分available/conditional/scope_only/insufficient_evidence；follow_up.conclusion_candidates只择会改变当前所问结论的缺项追问，execution_only仅用于落实动作。",
    "item_fields": "object_id,label,representation,observation_basis,evidence必填；zone与zone_observation_basis成对可选，属性确认与位置确认分别保存；只确认左右不能补近远，照片位置为image_observed",
    "layout_planning": "家具动作放layout_constraints；候选放layout_alternatives，声明changes并独立提供新位置placement/form_observation，许可和physically_feasible各自确认。候选fields追加layout_analysis.alternatives_analysis；ready表示可执行门槛，不表示各方法均有利。",
    "material_application": "material_facts.application显式选afsi_application_conditions_v1；有明确element_use才核相应水体清洁/流动、金属暴露/定性尺度或植物健康，各条件用value/observation_basis/evidence独立证据。",
    "material_facts": "材料器形用environmental_context.material_facts：fact_id/object_id/material?/shape?/colour?/plant_alive?/observation_basis/evidence；至少一属性，未知用unknown，属性按独立证据粒度保存。element_use只明确询问wood_remedy等代表物资格，不是个人喜用或房屋所需元素。",
    "method_reference": "纯方法/职业家具参考可用scene=home作通用家居参考查询标签，analyze_layout=false，按问题显式methods并投影method_details；年度对照仅加实际effective_year或确认的query_at。无真实环境事实时省略environmental_context，不提交空对象或仅household_scope。",
    "natal_delivery": "询问玄空宅盘时确认已选 xuankong_natal（可用 methods 显式选中）。通用 first_view 用于已执行布局分析；宅盘首读用 evidence_views.natal_candidates 取历史定运、朝向、全部候选、待补事实和来源。缺磁向用 house.facing_degrees 或 xuankong.house.facing_degrees 配同一 house 的 north_reference=magnetic。",
    "natal_interpretation": "玄空有限解释需 xuankong.interpretation 显式启用 xuankong_conditioned_v1；当前评价运 current_period_number 与 period_evidence 成对，不改历史宅运。external_forms 按全宅中心八宫独立确认外部山形/水形，未知省略，照片保留候选，不复用金锁砂水或室内靠背；床/门取用结合顶层 placements.location_direction，桌/灶未覆盖。",
    "natal_projection": "同次需要的视图在首轮合并 fields；result_delivery 只保留当次所选字段，分页沿同一 run 读回。兼容原始路径 layers.xuankong_natal.chart 只有唯一候选才有值；完整导出首次 fields=null。",
    "scene_selection": "工位scene=workstation，合租scene=shared_rental，家居scene=home；自动按事实展开飞星、金锁、八宅，局部前两法优先，显式methods优先。不为优先级补年份或宅运；年盘不替代历史宅盘。独立形态/桌面/context不要求生辰或罗盘。无场景无作者无context保留原三法默认。场景首轮fields按需追加method_policy；细节参考按需读method_details。",
    "surface_frame": "以坐着使用的桌沿为近沿near，远离坐者的桌沿为far；这是桌面坐标，不是房间前后或罗盘方向",
    "workstation_measured": "有实际尺寸的人工标注用workstation_layout.scene；+y图纸前方、桌面+x右/+y远沿，米制尺寸/高度/眼高/头顶高分别明确。compass独立提供北基准、角误差、参考中心和chart_binding_confirmed，sector_anchor明确坐者或桌中心；不自动立极。照片/坐标误差保持候选，清单不完整时未列观察仍未知。",
    "workstation_review": "工位工作/学习用途用 environmental_context.workstation_review.activities，逐项显式选 workstation_activity_authored_v1 并给实际活动/证据；按 placements.location_direction 读取各候选宅盘向星，位置与朝向分开，不要求外部有水或桌上放水。评价运可用该review.evaluation_period独立确认，不以日期/宅运代替。",
    "zone_legend": {
      "far_center": "远中/远沿中",
      "far_left": "左后/远沿左",
      "far_right": "右后/远沿右",
      "middle_center": "中心",
      "middle_left": "左中",
      "middle_right": "右中",
      "near_center": "近中/靠身体中",
      "near_left": "左前/靠身体左",
      "near_right": "右前/靠身体右"
    }
  },
  "evidence_views": {
    "natal_candidates": {
      "fields": [
        "status",
        "layers.xuankong_natal.status",
        "layers.xuankong_natal.period_context",
        "layers.xuankong_natal.orientation_context",
        "layers.xuankong_natal.candidates",
        "layers.xuankong_natal.missing_inputs",
        "rulesets",
        "rule_trace"
      ],
      "purpose": "玄空宅盘候选星盘与定运朝向依据"
    },
    "natal_patterns": {
      "fields": [
        "status",
        "layers.xuankong_natal.status",
        "layers.xuankong_natal.period_context",
        "layers.xuankong_natal.orientation_context",
        "layers.xuankong_natal.chart",
        "layers.xuankong_natal.candidates",
        "layers.xuankong_natal.missing_inputs",
        "rulesets",
        "rule_trace"
      ],
      "purpose": "玄空宅盘格局与挨星盘面"
    }
  },

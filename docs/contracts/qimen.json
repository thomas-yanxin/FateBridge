{
  "evidence_views": {
    "directional": {
      "fields": [
        "analysis_context",
        "four_pillars",
        "qimen.ju_text",
        "qimen.dun_type",
        "qimen.xun_head",
        "qimen.kongwang",
        "qimen.zhifu",
        "qimen.zhishi",
        "qimen.palaces",
        "qimen.ju_method",
        "qimen.calendar_policy",
        "qimen.stem_context",
        "qimen.rule_profiles",
        "qimen.rulesets",
        "qimen.structure",
        "qimen.patterns",
        "qimen.source_disagreements",
        "qimen.assessment",
        "qimen.engine"
      ],
      "when": "读相关宫位与方位；局号不能代替九宫；不把盘面当现实结果保证"
    },
    "stem_candidates": {
      "fields": [
        "four_pillars",
        "qimen.stem_context",
        "qimen.source_disagreements"
      ],
      "when": "核对伏干、飞干、岁格或月朔格：候选的共同结果与仍有分歧的宫位分别读取，不把候选当正式格局"
    }
  },
  "first_view": {
    "fields": [
      "analysis_context",
      "four_pillars",
      "qimen.ju_text",
      "qimen.dun_type",
      "qimen.xun_head",
      "qimen.kongwang",
      "qimen.zhifu",
      "qimen.zhishi",
      "qimen.palaces",
      "qimen.ju_method",
      "qimen.structure",
      "qimen.source_disagreements",
      "qimen.engine"
    ]
  },
  "input": {
    "$defs": {
      "QimenOptions": {
        "additionalProperties": false,
        "description": "Typed Qi Men Dun Jia configuration options.",
        "properties": {
          "god_profile": {
            "default": "yanyi_text",
            "description": "八神表：yanyi_text（默认卷三正文）或 yanyi_diagrams（卷四圆图）。",
            "enum": [
              "yanyi_text",
              "yanyi_diagrams"
            ],
            "title": "God Profile",
            "type": "string"
          },
          "ju_method": {
            "default": "zhirun",
            "description": "定局法：zhirun（默认置闰）或 chaibu（拆补）。",
            "enum": [
              "zhirun",
              "chaibu"
            ],
            "title": "Ju Method",
            "type": "string"
          },
          "layout": {
            "default": "direct",
            "description": "转盘排法：direct/rotating。",
            "enum": [
              "direct",
              "rotating"
            ],
            "title": "Layout",
            "type": "string"
          },
          "season_profile": {
            "default": "yanyi_vol1_verse",
            "description": "九星旺衰表：yanyi_vol1_verse（默认卷一烟波钓叟赋）、yanyi_vol3_table（卷三表）或 yanyi_vol3_prose（卷三正文）。",
            "enum": [
              "yanyi_vol1_verse",
              "yanyi_vol3_table",
              "yanyi_vol3_prose"
            ],
            "title": "Season Profile",
            "type": "string"
          }
        },
        "title": "QimenOptions",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Request model for Qi Men analysis.",
    "properties": {
      "analysis_day": {
        "description": "Analysis day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "title": "Analysis Day",
        "type": "integer"
      },
      "analysis_hour": {
        "description": "Analysis hour (0-23)",
        "maximum": 23,
        "minimum": 0,
        "title": "Analysis Hour",
        "type": "integer"
      },
      "analysis_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis longitude",
        "title": "Analysis Longitude"
      },
      "analysis_minute": {
        "default": 0,
        "description": "Analysis minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "title": "Analysis Minute",
        "type": "integer"
      },
      "analysis_month": {
        "description": "Analysis month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "title": "Analysis Month",
        "type": "integer"
      },
      "analysis_second": {
        "default": 0,
        "description": "Analysis second (0-59)",
        "maximum": 59,
        "minimum": 0,
        "title": "Analysis Second",
        "type": "integer"
      },
      "analysis_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis timezone (IANA name or UTC offset)",
        "title": "Analysis Timezone"
      },
      "analysis_utc_offset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "已确认的民用 UTC 偏移，格式 ±HH:MM 或 ±HH:MM:SS，用于消歧重复钟时。",
        "title": "Analysis Utc Offset"
      },
      "analysis_year": {
        "description": "Analysis year, e.g., 2026",
        "title": "Analysis Year",
        "type": "integer"
      },
      "qimen_options": {
        "$ref": "#/$defs/QimenOptions",
        "description": "奇门选项：ju_method=zhirun（默认置闰）/chaibu（拆补）；god_profile=yanyi_text（默认卷三正文）/yanyi_diagrams（卷四圆图）；season_profile=yanyi_vol1_verse（默认卷一赋）/yanyi_vol3_table/yanyi_vol3_prose；layout=direct/rotating。"
      },
      "use_true_solar_time": {
        "default": true,
        "description": "Enable true solar time correction (default on — 奇门 定局 keys off the apparent-solar 时辰)",
        "title": "Use True Solar Time",
        "type": "boolean"
      }
    },
    "required": [
      "analysis_year",
      "analysis_month",
      "analysis_day",
      "analysis_hour"
    ],
    "title": "QimenAnalysisRequest",
    "type": "object"
  },
  "tool": "qimen"
}

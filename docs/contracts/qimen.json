{
  "evidence_views": {
    "directional": {
      "fields": [
        "analysis_context",
        "four_pillars",
        "qimen.ju_text",
        "qimen.dun_type",
        "qimen.xun_head",
        "qimen.kongwang",
        "qimen.zhifu",
        "qimen.zhishi",
        "qimen.palaces",
        "qimen.ju_method",
        "qimen.calendar_policy",
        "qimen.stem_context",
        "qimen.rule_profiles",
        "qimen.rulesets",
        "qimen.structure",
        "qimen.patterns",
        "qimen.source_disagreements",
        "qimen.assessment",
        "qimen.engine"
      ],
      "when": "读相关宫位与方位；局号不能代替九宫；不把盘面当现实结果保证"
    },
    "stem_candidates": {
      "fields": [
        "four_pillars",
        "qimen.stem_context",
        "qimen.source_disagreements"
      ],
      "when": "核对伏干、飞干、岁格或月朔格：候选的共同结果与仍有分歧的宫位分别读取，不把候选当正式格局"
    }
  },
  "first_view": {
    "fields": [
      "analysis_context",
      "four_pillars",
      "qimen.ju_text",
      "qimen.dun_type",
      "qimen.xun_head",
      "qimen.kongwang",
      "qimen.zhifu",
      "qimen.zhishi",
      "qimen.palaces",
      "qimen.ju_method",
      "qimen.structure",
      "qimen.source_disagreements",
      "qimen.engine"
    ],
    "include_snapshot_text": false,
    "strict_fields": true
  },
  "input": {
    "additionalProperties": false,
    "description": "Request model for Qi Men analysis.",
    "properties": {
      "analysis_day": {
        "description": "Analysis day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "title": "Analysis Day",
        "type": "integer"
      },
      "analysis_hour": {
        "description": "Analysis hour (0-23)",
        "maximum": 23,
        "minimum": 0,
        "title": "Analysis Hour",
        "type": "integer"
      },
      "analysis_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis longitude",
        "title": "Analysis Longitude"
      },
      "analysis_minute": {
        "default": 0,
        "description": "Analysis minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "title": "Analysis Minute",
        "type": "integer"
      },
      "analysis_month": {
        "description": "Analysis month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "title": "Analysis Month",
        "type": "integer"
      },
      "analysis_second": {
        "default": 0,
        "description": "起局钟表秒数（0-59），用于节气实刻与真太阳时辰边界；不代表秒级预测精度。",
        "maximum": 59,
        "minimum": 0,
        "title": "Analysis Second",
        "type": "integer"
      },
      "analysis_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis timezone (IANA name or UTC offset)",
        "title": "Analysis Timezone"
      },
      "analysis_utc_offset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "起局钟时的明确UTC偏移，格式±HH:MM或±HH:MM:SS；与analysis_timezone共同核对并消除重复小时歧义，不替换该时区的全年规则。省略时拒绝不明确或不存在的钟时。",
        "title": "Analysis Utc Offset"
      },
      "analysis_year": {
        "description": "Analysis year, e.g., 2026",
        "title": "Analysis Year",
        "type": "integer"
      },
      "qimen_options": {
        "additionalProperties": true,
        "description": "奇门选项：ju_method=zhirun（默认置闰）/chaibu（拆补）；god_profile=yanyi_text（默认卷三正文）/yanyi_diagrams（卷四圆图）；season_profile=yanyi_vol1_verse（默认卷一赋）/yanyi_vol3_table/yanyi_vol3_prose；仅支持转盘layout=direct、palaceShift=0",
        "title": "Qimen Options",
        "type": "object"
      },
      "selected_sections": {
        "description": "Optional snapshot section titles for filtered export payload",
        "items": {
          "type": "string"
        },
        "title": "Selected Sections",
        "type": "array"
      },
      "use_true_solar_time": {
        "default": true,
        "description": "Enable true solar time correction (default on — 奇门 定局 keys off the apparent-solar 时辰)",
        "title": "Use True Solar Time",
        "type": "boolean"
      }
    },
    "required": [
      "analysis_year",
      "analysis_month",
      "analysis_day",
      "analysis_hour"
    ],
    "title": "QimenAnalysisRequest",
    "type": "object"
  },
  "method_contracts": [
    {
      "comparison_requirements": [
        "相同方法合同、实现与数据版本、选项及实际计算层"
      ],
      "dependencies": [
        "validated_request"
      ],
      "error_sources": [
        "civil_clock",
        "solar_clock",
        "calendar_model",
        "rule_adjudication"
      ],
      "implementation_refs": [
        "src/fatebridge/services/metaphysics.py"
      ],
      "limitations": [
        "contract_v1是登记合同版本，不冒充上游原典或数值算法版本；实际版本另列runtime_method_ids",
        "登记不认证全书、全部历史范围、连续区间稳定或现实预测"
      ],
      "method_id": "fatebridge.qimen_rotating_board.contract_v1",
      "output_paths": [
        "qimen"
      ],
      "prerequisites": [
        "请求Schema及领域前提必须成立；条件分支以本次实际回执为准"
      ],
      "quantity_kind": "traditional_rule_result",
      "role": "calculation",
      "selector_fields": [
        "qimen_options"
      ],
      "source_refs": [
        "docs/algorithm-coverage.md"
      ],
      "unit": "categorical",
      "validation_scope": {
        "numerical": "method_specific_reference_required",
        "real_world_validity": "not_established",
        "source_conformity": "not_fully_accepted"
      }
    }
  ],
  "tool": "qimen"
}

  "input": {
    "additionalProperties": false,
    "properties": {
      "analysis_day": {
        "description": "Analysis day (1-31)",
        "maximum": 31,
        "minimum": 1,
        "type": "integer"
      },
      "analysis_hour": {
        "description": "Analysis hour (0-23)",
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "analysis_longitude": {
        "anyOf": [
          {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis longitude"
      },
      "analysis_minute": {
        "default": 0,
        "description": "Analysis minute (0-59)",
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      },
      "analysis_month": {
        "description": "Analysis month (1-12)",
        "maximum": 12,
        "minimum": 1,
        "type": "integer"
      },
      "analysis_timezone": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis timezone (IANA name or UTC offset)"
      },
      "analysis_utc_offset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "起局钟时的明确UTC偏移，格式±HH:MM或±HH:MM:SS；与analysis_timezone共同核对并消除重复小时歧义，不替换该时区的全年规则。省略时拒绝不明确或不存在的钟时。"
      },
      "analysis_year": {
        "description": "Analysis year, e.g., 2026",
        "type": "integer"
      },
      "as_of": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Freeze implicit current time: ISO 8601 datetime with timezone"
      },
      "compact": {
        "default": true,
        "description": "紧凑 JSON 输出（无缩进）；设为 false 则美化缩进。默认 true。",
        "type": "boolean"
      },
      "fields": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "仅返回选定字段以节省 token：接受顶层键（如 'snapshot_text'）或点路径子字段（如 'bazi_birth.day_master'）。run_metadata 始终保留；留空请求全部字段，超出响应字符预算的部分由 result_delivery 保留供读取。无效路径默认附 projection_warnings；strict_fields=true 时拒绝。"
      },
      "include_snapshot_text": {
        "default": true,
        "description": "是否包含人类可读的 snapshot_text 文本段（默认随工具而定）；设为 false 可显著减少返回的 token 数。",
        "type": "boolean"
      },
      "parent_run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Parent call's run_id; correlation only, no stored execution lookup"
      },
      "qimen_options": {
        "additionalProperties": true,
        "default": {},
        "description": "奇门选项：ju_method=zhirun（默认置闰）/chaibu（拆补）；god_profile=yanyi_text（默认卷三正文）/yanyi_diagrams（卷四圆图）；season_profile=yanyi_vol1_verse（默认卷一赋）/yanyi_vol3_table/yanyi_vol3_prose；仅支持转盘layout=direct、palaceShift=0",
        "type": "object"
      },
      "response_char_limit": {
        "anyOf": [
          {
            "const": 0,
            "type": "integer"
          },
          {
            "maximum": 65536,
            "minimum": 4096,
            "type": "integer"
          }
        ],
        "default": 8192,
        "description": "完整 JSON 响应字符预算：0 不限制，或 4096–65536。MCP 默认 8192，REST/CLI 默认 0。超限不截断数据，返回 result_delivery 完整结果引用和可读取字段；按 manifest_uri 或字段分页读取原 run 的数据，不要重新计算或解析单页为完整文档。"
      },
      "selected_sections": {
        "default": [],
        "description": "Optional snapshot section titles for filtered export payload",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "strict_fields": {
        "default": false,
        "description": "是否拒绝无效 fields 路径；默认 false，使用宽松投影并返回警告。",
        "type": "boolean"
      },
      "trace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Caller trace ID"
      },
      "use_true_solar_time": {
        "default": true,
        "description": "Enable true solar time correction (default on — 奇门 定局 keys off the apparent-solar 时辰)",
        "type": "boolean"
      }
    },
    "required": [
      "analysis_year",
      "analysis_month",
      "analysis_day",
      "analysis_hour"
    ],
    "type": "object"
  },

  "entry_rule": {
    "quote": "凡占天時，不分體用，全觀諸卦，詳推五行。",
    "source_id": "meihua-volume-2",
    "section": "天時占第一"
  },
  "policies": [
    {
      "id": "six_slots",
      "kind": "software_convention",
      "statement": "全观选择本、互、变上下六个位置；重复出现逐位置记录，无权重，无错综卦。原文未唯一规定计数分母。"
    },
    {
      "id": "many",
      "kind": "unadjudicated_quantifier",
      "statement": "多没有原文数值阈值。仅在调用者事前明示many_min_count时按该软件约定检验；否则保留待定。六位置原始status保留，同时核对静卦只计一次的五位置候选；有分歧时effective_status及实际解读明确标为频数范围未裁定，不暗选分母或阈值。"
    },
    {
      "id": "pair",
      "kind": "software_convention",
      "statement": "在上、两同或相逢等组合按同一个本/互/变重卦匹配，不把不同卦的两个位置擅自拼成上下组合。"
    },
    {
      "id": "season",
      "kind": "conditional_text_scope",
      "statement": "雷电和霜雪条款结合章末夏天及冬月条件。时区、节月五行旺衰不替代已核定的气象季节。"
    },
    {
      "id": "conflicts",
      "kind": "software_convention",
      "statement": "通象与专条全部保留；不投票、不累积分数、不以体用裁天气、不编造晴雨优先级或自动时间窗。"
    },
    {
      "id": "retained_casts",
      "kind": "software_evidence_convention",
      "statement": "若取爻原数与卦序数产生不同实际候选，每套候选使用自身本互变、动爻与同一已确认天气条件计算同一规则。casting_variants供首轮分列，casting_variant_traces供完整核对；只报告所选条件下规则差异，不投票、合并计数或按已知天气选候选。"
    },
    {
      "id": "gen_rain_stop_vs_clear",
      "kind": "conditional_text_scope",
      "statement": "一般久雨得艮的雨止象与艮多久雨必晴是分别核对的原文条款。后者须已确认久雨和明示多字阈值，并保留五／六位置分歧。久晴不雨得此亦然的指代仍未唯一裁定，不自动反推见艮必雨。"
    },
    {
      "id": "source_wording_variants",
      "kind": "textual_evidence_policy",
      "statement": "保留固定转录引文及影印所选字句；四时必雨与四时多雨等差异逐条公开，不把影印目读写成独立专家认证，也不把多雨改写为百分之百有雨。"
    },
    {
      "id": "seasonal_named_element_membership",
      "kind": "software_convention_with_explicit_text_basis",
      "statement": "乾兑金、坤艮土按所列卦类任一出现匹配，不要求两卦同现，不附加多字阈值；仍取实际本互变六位置。三条新增季节句以固定卷二转录1441921为计算依据；影像冬句缺主语、春句兑/艮字差异分别保留，不宣称两版一致或据五行纠正刻字。"
    },
    {
      "id": "source_daypart_labels",
      "kind": "source_scoped_temporal_representation",
      "statement": "离在艮上暮雨朝晴拆为朝晴、暮雨两项原文时段，条件仍为实际同一重卦上离下艮。朝暮不换算钟时、日出日落或日期，也不假定已经定位同一具体公历日。原38条未定时段条款不解释为全天；保留同一时段、不同朝暮、未定时段之间的不同关系，不投票或自动交集。",
      "unprovided_calendar_date": null,
      "unprovided_clock_intervals": null
    }
  ],

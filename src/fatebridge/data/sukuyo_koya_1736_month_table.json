  "day_columns": [
    {
      "day": 1,
      "text": "奎胃畢參鬼張角氐心斗虛室",
      "frame": 14,
      "side": "left",
      "column_from_right": 1
    },
    {
      "day": 2,
      "text": "婁昴觜井柳翼亢房尾女危壁",
      "frame": 14,
      "side": "left",
      "column_from_right": 2
    },
    {
      "day": 3,
      "text": "胃畢參鬼星軫亢心箕虛室奎",
      "frame": 15,
      "side": "right",
      "column_from_right": 1
    },
    {
      "day": 4,
      "text": "昴觜井柳張角房尾斗危壁婁",
      "frame": 15,
      "side": "right",
      "column_from_right": 2
    },
    {
      "day": 5,
      "text": "畢參鬼星翼亢心箕女室奎胃",
      "frame": 15,
      "side": "right",
      "column_from_right": 3
    },
    {
      "day": 6,
      "text": "觜井柳張軫氐尾斗虛壁婁昴",
      "frame": 15,
      "side": "right",
      "column_from_right": 4
    },
    {
      "day": 7,
      "text": "參鬼星翼角房箕女危奎胃畢",
      "frame": 15,
      "side": "right",
      "column_from_right": 5
    },
    {
      "day": 8,
      "text": "井柳張軫亢心斗虛室婁昴觜",
      "frame": 15,
      "side": "right",
      "column_from_right": 6
    },
    {
      "day": 9,
      "text": "鬼星翼角氐尾女危壁胃畢參",
      "frame": 15,
      "side": "right",
      "column_from_right": 7
    },
    {
      "day": 10,
      "text": "柳張軫亢房箕虛室奎昴觜井",
      "frame": 15,
      "side": "right",
      "column_from_right": 8
    },
    {
      "day": 11,
      "text": "星翼角氐心斗危壁婁畢參鬼",
      "frame": 15,
      "side": "right",
      "column_from_right": 9
    },
    {
      "day": 12,
      "text": "張軫亢房尾女室奎胃觜井柳",
      "frame": 15,
      "side": "right",
      "column_from_right": 10
    },
    {
      "day": 13,
      "text": "翼角氐心箕虛壁婁昴參鬼星",
      "frame": 15,
      "side": "left",
      "column_from_right": 1
    },
    {
      "day": 14,
      "text": "軫亢房尾斗危奎胃畢井柳張",
      "frame": 15,
      "side": "left",
      "column_from_right": 2
    },
    {
      "day": 15,
      "text": "角氐心箕女室婁昴觜鬼星翼",
      "frame": 15,
      "side": "left",
      "column_from_right": 3
    },
    {
      "day": 16,
      "text": "亢房尾斗虛壁胃畢參柳張軫",
      "frame": 15,
      "side": "left",
      "column_from_right": 4
    },
    {
      "day": 17,
      "text": "氐心箕女危奎昴觜井星翼角",
      "frame": 15,
      "side": "left",
      "column_from_right": 5
    },
    {
      "day": 18,
      "text": "房尾斗虛室婁畢參鬼張軫亢",
      "frame": 15,
      "side": "left",
      "column_from_right": 6
    },
    {
      "day": 19,
      "text": "心箕女危壁胃觜井柳翼角氐",
      "frame": 15,
      "side": "left",
      "column_from_right": 7
    },
    {
      "day": 20,
      "text": "尾斗虛室奎昴參鬼星軫亢房",
      "frame": 15,
      "side": "left",
      "column_from_right": 8
    },
    {
      "day": 21,
      "text": "箕女危壁婁畢井柳張角氐心",
      "frame": 15,
      "side": "left",
      "column_from_right": 9
    },
    {
      "day": 22,
      "text": "斗虛室奎胃觜鬼星翼亢房尾",
      "frame": 15,
      "side": "left",
      "column_from_right": 10
    },
    {
      "day": 23,
      "text": "女危壁婁昴參柳張軫氐心箕",
      "frame": 16,
      "side": "right",
      "column_from_right": 1
    },
    {
      "day": 24,
      "text": "虛室奎胃畢井星翼角房尾斗",
      "frame": 16,
      "side": "right",
      "column_from_right": 2
    },
    {
      "day": 25,
      "text": "危壁婁昴觜鬼張軫亢心箕女",
      "frame": 16,
      "side": "right",
      "column_from_right": 3
    },
    {
      "day": 26,
      "text": "室奎胃畢參柳翼角氐尾斗虛",
      "frame": 16,
      "side": "right",
      "column_from_right": 4
    },
    {
      "day": 27,
      "text": "壁婁昴觜井星軫亢房箕女危",
      "frame": 16,
      "side": "right",
      "column_from_right": 5
    },
    {
      "day": 28,
      "text": "奎胃畢參鬼張角氐心斗虛室",
      "frame": 16,
      "side": "right",
      "column_from_right": 6
    },
    {
      "day": 29,
      "text": "婁昴觜井柳翼亢房尾女危壁",
      "frame": 16,
      "side": "right",
      "column_from_right": 7
    },
    {
      "day": 30,
      "text": "胃畢參鬼星軫亢心箕虛室奎",
      "frame": 16,
      "side": "right",
      "column_from_right": 8
    }

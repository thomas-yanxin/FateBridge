          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0398a09-10",
          "source_excerpts": [
            "若危壞日，並不宜遠行出、入移徙、買賣、婚姻"
          ],
          "meaning": "下卷此处列危、坏日远行、迁徙、买卖及婚姻不宜；保留远行条件及危日婚姻冲突。",
          "primary_paragraph_id": "0398a0901"
        },

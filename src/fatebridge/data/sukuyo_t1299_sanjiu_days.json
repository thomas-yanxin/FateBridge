          "source_excerpts": [
            "凡命、胎宿直日，不宜舉動百事"
          ],
          "meaning": "上卷命、胎日列不宜举动百事。",
          "primary_paragraph_id": "0391b1901"
        },
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0398a07",
          "source_excerpts": [
            "若命宿日、胎宿日，不宜舉動百事"
          ],
          "meaning": "下卷命、胎日列不宜举动百事。",
          "primary_paragraph_id": "0398a0701"
        },
        {
          "volume": "lower",
          "source_witness": "another_saying",
          "locator": "T21n1299_p0398a16-17",
          "source_excerpts": [
            "又一說云：命宿、胎宿、危宿、壞宿，此宿日不得進路"
          ],
          "meaning": "下卷又一说另列命、胎、危、坏日不得进路；按明确启程核对，不把所有旅行活动都当作出发。",
          "primary_paragraph_id": "0398a1601"
        }
      ],
      "upper_day_entry_individually_listed": true

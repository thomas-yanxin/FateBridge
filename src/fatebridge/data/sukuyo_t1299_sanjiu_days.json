    {
      "relation": "業",
      "witnesses": [
        {
          "volume": "upper",
          "source_witness": "main_text",
          "locator": "T21n1299_p0391b19-25",
          "source_excerpts": [
            "業宿直日，所作皆吉祥"
          ],
          "meaning": "上卷业日列所作皆吉祥。",
          "primary_paragraph_id": "0391b1901"
        },
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0398a07-08",
          "source_excerpts": [
            "值業宿日，所作善惡亦不成就，甚衰"
          ],
          "meaning": "下卷业日列所作善恶亦不成就，与上卷相反。",
          "primary_paragraph_id": "0398a0701"
        }
      ],
      "upper_day_entry_individually_listed": true
    },
    {
      "relation": "栄",
      "witnesses": [
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0397c25-28",
          "source_excerpts": [
            "興營買賣"
          ],
          "meaning": "下卷荣日列兴营买卖。",
          "primary_paragraph_id": "0397c2501"
        },
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0397c27-28",
          "source_excerpts": [
            "承事師主、啟請法要並吉"
          ],
          "meaning": "下卷在出家人段落列承事师主、启请法要；该身份与动作须明确，不能只凭宗教学法就补造出家人身份。",
          "primary_paragraph_id": "0397c2501"
        }
      ],
      "upper_day_entry_individually_listed": false
    },
    {
      "relation": "衰",
      "witnesses": [
        {
          "volume": "upper",
          "source_witness": "main_text",
          "locator": "T21n1299_p0391b19-25",
          "source_excerpts": [
            "衰、危、壞宿日，並不宜遠行"
          ],
          "meaning": "上卷远行条文须核对路程；迁徙、买卖另按事项核对。",
          "primary_paragraph_id": "0391b1901"
        },
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0398a11",
          "source_excerpts": [
            "若衰日"
          ],
          "meaning": "下卷此行仅列本服务不交付的事项；没有据此补造六类事项的一般禁忌。",
          "primary_paragraph_id": "0398a1101"
        }
      ],
      "upper_day_entry_individually_listed": true
    },
    {
      "relation": "安",
      "witnesses": [
        {
          "volume": "upper",
          "source_witness": "main_text",
          "locator": "T21n1299_p0391b19-25",
          "source_excerpts": [
            "安日，移動遠行、修園宅臥具、作壇場並吉"
          ],
          "meaning": "上卷安日列移动远行及修园宅卧具。",
          "primary_paragraph_id": "0391b1901"
        },
        {
          "volume": "lower",
          "source_witness": "main_text",
          "locator": "T21n1299_p0397c29-0398a01",
          "source_excerpts": [
            "若安宿日，移徙吉，遠行人入宅"
          ],
          "meaning": "下卷分别列移徙吉与远行人入宅；按明确远行人入宅查文献，不限定为回自己家，也不改写为所有出发均吉。",
          "primary_paragraph_id": "0397c2901"
        }
      ],
      "upper_day_entry_individually_listed": true
    },
    {

  "clock_doctrine": {
    "id": "t1299_daybreak_eight_times_reference_v1",
    "source_url": "https://cbetaonline.dila.edu.tw/zh-tw/T1299",
    "source_sha256": "8a3e11e428dc8352e4ac163d839dea23df875dc74069ccd38cadd89e1878c006",
    "locator": "T21n1299_p0399b25-28",
    "source_excerpt": "國，未審知委。其曜亦每日分為八時，平明即是所直之曜，乃至酉戌，則八時而周。夜亦分為八時，轉到明日曉時，即次後曜當直。如是細解，用之萬不失一。",
    "day_parts": 8,
    "night_parts": 8,
    "starting_boundary_literal": "平明",
    "next_boundary_literal": "明日曉時",
    "intradaily_luminary_order": null,
    "physical_clock_mapping_status": "not_established",
    "western_24_hora_applied": false,
    "scope": "仅交付所选原段的日夜各八时及平明起曜。段内未逐时列曜神顺序，不以日曜序列或西方24行星时补写；酉戌保留原字，未映射为现代固定钟时。",
    "source_claim_is_empirical_validation": false
  },
  "verse_abbreviation_resolution": {
    "id": "t1299_white_one_night_abbreviation_v1",
    "locator": "T21n1299_p0393c26",
    "source_url": "https://cbetaonline.dila.edu.tw/zh-tw/T1299",
    "source_sha256": "8a3e11e428dc8352e4ac163d839dea23df875dc74069ccd38cadd89e1878c006",
    "source_excerpt": "所謂一夜者，十一夜也。勒頌者貴省文也",
    "xml_kind": "note[@place=inline]",
    "literal_expression": "一夜",
    "literal_lunar_day": 1,
    "interpreted_lunar_day": 11,
    "resolution_status": "resolved_by_source_inline_gloss",
    "scope": "下卷夹注明说一夜指十一夜；上卷同偈按其平行散文及该注释义。保留字面，不再把一字误算成初一夜限制；未判定现代钟时。"
  },

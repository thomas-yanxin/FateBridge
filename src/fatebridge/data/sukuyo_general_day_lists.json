      ],
      "favorable_source_paragraphs": [
        {
          "xml_id": "pT21p0394a0101",
          "text": "每入月，一日十六日、三日十八日、五日二十日、七日二十二日、十日二十五日、十一日二十六日、十三日二十八日。"
        },
        {
          "xml_id": "pT21p0394a0401",
          "text": "已上是吉日，所作吉祥事必成就。"
        }
      ],
      "conditional_source_paragraphs": [
        {
          "xml_id": "pT21p0394a1101",
          "text": "入月，二日六日、九日十二日、十四日十七日、十九日二十一日、二十三日二十四、日二十七日三十日。"
        },
        {
          "xml_id": "pT21p0394a1401",
          "text": "已上平日，若與好宿好曜并者即吉，如與惡宿惡曜并者即凶。夫凶惡晝日中已後通吉用，凶惡夜半已後亦通吉用。"
        }
      ]
    }

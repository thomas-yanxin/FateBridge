      "favorable_source_paragraphs": [
        {
          "xml_id": "pT21p0393a0101",
          "text": "凡月有黑白兩分，從一日至十五日為白月分，從十六日至三十日為黑分。每月白月一日三日五日七日十日十一日十三日，黑月一日三日五日七日十日十一日十三日，所向皆成就，名為吉祥日。"
        }
      ],
      "conditional_source_paragraphs": [
        {
          "xml_id": "pT21p0393a0901",
          "text": "又白月二日六日九日十二日，又黑月二日六日九日十二日十四日，此等平平時，隨立宿曜為吉凶。"
        }
      ]
    },
    {
      "witness": "lower_prose",

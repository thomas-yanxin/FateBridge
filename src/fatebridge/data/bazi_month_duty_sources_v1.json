  "ditian_ren_commentary": {
    "source": "ditian_1947",
    "source_layer": "任氏增注",
    "conditions": [
      "地支人元与天干引助须合参，司令出现也未必可用。",
      "寅月戊土虽司令出见仍可能置而弗论，不能把透出当充分条件。",

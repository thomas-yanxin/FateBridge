  "lunar_replacement_c": "\n  /* Named VSOP2013/full-Moshier-Moon model, not a stock build.\n     Use the full standalone geometric lunar series and the exact queried\n     epoch's obliquity. Do not depend on cached oec at another sample time. */\n  {\n    double moon[3];\n    double epsilon = swi_epsiln(tjd, 0);\n    int k;\n    if (swi_moshmoon2(tjd, moon) != 0) {\n      for (k = 0; k < 3; k++) xemb[k] = NAN;\n      return;\n    }\n    swi_polcart(moon, moon);\n    swi_coortrf2(moon, moon, -sin(epsilon), cos(epsilon));\n    swi_precess(moon, tjd, 0, J_TO_J2000);\n    for (k = 0; k < 3; k++) xemb[k] -= moon[k] / (EARTH_MOON_MRAT + 1.0);\n    return;\n  }\n",
  "source_identity_scope": "Pinned full-series EMB and complete lunar offset; geocentric full ERFA time conversion. Local source/build identity is not upstream endorsement, future UTC certification, continuous all-epoch physical certification or stock Moshier certification.",

        "stove"
      ],
      "rule_id": "indoor_command_authored_v1.off_entry_line",
      "source_ids": [
        "F1"
      ],
      "adjustment": "偏移使用位置，避开已确认的入口直线；保留可见入口的关系"
    },
    {
      "criterion": "solid_backing",
      "expected": true,
      "purposes": [
        "bed",
        "desk"
      ],
      "rule_id": "indoor_command_authored_v1.solid_backing",
      "source_ids": [
        "F1",
        "F2"
      ],
      "adjustment": "优先比较有实体背靠的位置；床可核对稳固床头支撑，不能以帘布等同实体背靠"
    },
    {
      "criterion": "passage_direct_line",
      "expected": false,
      "purposes": [
        "desk"
      ],
      "optional": true,
      "rule_id": "indoor_command_authored_v1.passage_direct_line",
      "source_ids": [
        "F4"
      ],
      "adjustment": "核对可否偏移使用位置以避开已确认的直走道；不能调整时保留权衡"
    },
    {
      "criterion": "exposed_beam_over_user",
      "expected": false,
      "purposes": [
        "desk"
      ],
      "optional": true,
      "rule_id": "indoor_command_authored_v1.exposed_beam_over_user",
      "source_ids": [
        "F4"
      ],
      "adjustment": "比较不在已确认裸露梁下的使用位置；不可移动时不承诺摆件化解"
    },
    {
      "criterion": "sharp_corner_points_at_user",
      "expected": false,
      "purposes": [
        "desk"
      ],
      "optional": true,
      "rule_id": "indoor_command_authored_v1.sharp_corner_points_at_user",
      "source_ids": [
        "F4"
      ],
      "adjustment": "优先移开或转开已确认朝向人的尖角；仅在实际屏障可行且不挡入口时考虑叶状植物"
    }
  ],

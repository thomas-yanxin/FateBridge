  "rulesets": {
    "indoor_command_authored_v1": {
      "version": "1.1.1",
      "method": "indoor_forms",
      "source_ids": [
        "F1",
        "F2",
        "F3",
        "F4"
      ],
      "scope": "现代作者室内控制位置规则，床桌灶适用条件；不等于完整峦头、金锁或玄空形法",
      "conventions": [
        "使用者坐姿/使用方向为参考；入口相对位置不等于全宅落宫",
        "直线冲与可见性必须分别确认；右后入口不自动认定门冲",
        "照片观察仅为候选，测量/用户确认方可作确认结论",
        "没有距离吉凶阈值；实体背靠判定适用于床和桌，不强加给灶",
        "实际入口与经过通道分别记录；只有明确窗位置时才检查侧窗作者条件"
      ]
    },
    "afsi_element_balance_v1": {
      "version": "1.0.1",
      "method": "element_adjustment",
      "source_ids": [
        "E1",
        "E3"
      ],
      "scope": "明确目标下的生/泄元素与代表物；目标从选定计算事实绑定，不由命卦推导喜用神或缺元素",
      "conventions": [
        "实际元素与色彩替代分别列示；不规定数量、重量、距离或效果概率",
        "目标方法、宅/人、位置/朝向、玄空角色各自绑定；候选盘不形成确认处方",
        "不以灶座凶方用途推导削弱游年星；未有对应来源时标明不支持",
        "E3反对摆件化解，与E1的教学路线分列，不宣称全门派一致"
      ]
    },
    "pang_2026_annual_v1": {
      "version": "1.0.1",
      "method": "annual_element_remedy",
      "source_ids": [
        "E1",
        "E2",
        "E3"
      ],
      "scope": "作者2026年盘南5/西北2的有限年度调节候选；仅对象所在宫位，不依面朝方向，也不替代完整宅盘",
      "conventions": [
        "显式选择本版本；其他年份不外推，其他星不生成本版本处方",
        "排除原文健康/灾害预测，盐水配方、数量/重量及发声强度规则未实现",
        "保留反对物件路线的作者立场；方法不同不合成统一风水结论"
      ]
    }
  },
  "form_rules": [

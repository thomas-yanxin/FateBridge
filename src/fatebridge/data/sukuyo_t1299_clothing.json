  "upper_literal_cutting_statements": [
    {
      "mansion": "昴",
      "source_excerpt": "若用裁衣必被火燒。",
      "xml_id": "pT21p0388c0801",
      "locator": "T21n1299_p0388c08",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "毕",
      "source_excerpt": "若用裁衣，必多饒事務。",
      "xml_id": "pT21p0388c1501",
      "locator": "T21n1299_p0388c15",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "觜",
      "source_excerpt": "此日裁衣，被鼠咬。",
      "xml_id": "pT21p0388c2201",
      "locator": "T21n1299_p0388c22",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "参",
      "source_excerpt": "若用裁衣，終慎鼠厄。",
      "xml_id": "pT21p0388c2901",
      "locator": "T21n1299_p0388c29",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "井",
      "source_excerpt": "若用裁衣，必相分離。",
      "xml_id": "pT21p0389a0501",
      "locator": "T21n1299_p0389a05",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "鬼",
      "source_excerpt": "若用裁衣，必有吉祥勝事。",
      "xml_id": "pT21p0389a1301",
      "locator": "T21n1299_p0389a13",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "柳",
      "source_excerpt": "若用裁衣，後必遭失。",
      "xml_id": "pT21p0389a2001",
      "locator": "T21n1299_p0389a20",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "星",
      "source_excerpt": "若用裁衣，後必損失。",
      "xml_id": "pT21p0389a2601",
      "locator": "T21n1299_p0389a26",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "张",
      "source_excerpt": "若用裁衣，必被官奪。",
      "xml_id": "pT21p0389b0501",
      "locator": "T21n1299_p0389b05",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "翼",
      "source_excerpt": "若用裁衣，後必更得財。",
      "xml_id": "pT21p0389b1101",
      "locator": "T21n1299_p0389b11",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "角",
      "source_excerpt": "若用裁衣，終當逃亡。",
      "xml_id": "pT21p0389b2301",
      "locator": "T21n1299_p0389b23",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "亢",
      "source_excerpt": "若用裁衣，後必得財。",
      "xml_id": "pT21p0389b2901",
      "locator": "T21n1299_p0389b29",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "氐",
      "source_excerpt": "若用裁衣，多逢親識。",
      "xml_id": "pT21p0389c0601",
      "locator": "T21n1299_p0389c06",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "房",
      "source_excerpt": "若用裁衣，後必更裁。",
      "xml_id": "pT21p0389c1201",
      "locator": "T21n1299_p0389c12",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "心",
      "source_excerpt": "若用裁衣，必遭死亡盜賊。",
      "xml_id": "pT21p0389c1801",
      "locator": "T21n1299_p0389c18",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "尾",
      "source_excerpt": "若用裁衣，必遭爛壞。",
      "xml_id": "pT21p0389c2501",
      "locator": "T21n1299_p0389c25",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "箕",
      "source_excerpt": "若用裁衣，後必得病。",
      "xml_id": "pT21p0390a0201",
      "locator": "T21n1299_p0390a02",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "斗",
      "source_excerpt": "若用裁衣，多得美味。",
      "xml_id": "pT21p0390a0801",
      "locator": "T21n1299_p0390a08",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "女",
      "source_excerpt": "若用裁衣，必足病痛。",
      "xml_id": "pT21p0390a1901",
      "locator": "T21n1299_p0390a19",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "虚",
      "source_excerpt": "若用裁衣，多得糧用。",
      "xml_id": "pT21p0390a2601",
      "locator": "T21n1299_p0390a26",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "危",
      "source_excerpt": "若用裁衣，心遭毒厄。",
      "xml_id": "pT21p0390b0601",
      "locator": "T21n1299_p0390b06",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "室",
      "source_excerpt": "若用裁衣，必遭水厄。",
      "xml_id": "pT21p0390b1201",
      "locator": "T21n1299_p0390b12",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "壁",
      "source_excerpt": "若用裁衣，多得財物。",
      "xml_id": "pT21p0390b1801",
      "locator": "T21n1299_p0390b18",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation",
      "literal_heading_mansion": "璧",
      "identification_basis": "Same paragraph pT21p0390b1801 explicitly says 壁二星 and annotation repeats 壁二星; preserve heading 璧 instead of a global homophone substitution."
    },
    {
      "mansion": "奎",
      "source_excerpt": "若用裁衣，必得寶器。",
      "xml_id": "pT21p0390b2401",
      "locator": "T21n1299_p0390b24",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "娄",
      "source_excerpt": "若用裁衣，必增益衣服。",
      "xml_id": "pT21p0390c0301",
      "locator": "T21n1299_p0390c03",
      "interpretation": "literal_forecast_not_aggregated_as_action_valuation"
    },
    {
      "mansion": "胃",
      "source_excerpt": "若用裁衣，必損減資福。",

      "paragraph_xml_id": "pT21p0397b0801",
      "locator": "T21n1299_p0397b08",
      "main_text": "第六女宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "取翼、軫日"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0901": {
      "paragraph_xml_id": "pT21p0397b0901",
      "locator": "T21n1299_p0397b09",
      "main_text": "第四蟹宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "取鬼、柳，日已上向南行大吉"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false

      "main_text": "第三男女宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "至參、井日，東行大吉"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b1101": {
      "paragraph_xml_id": "pT21p0397b1101",
      "locator": "T21n1299_p0397b11",
      "main_text": "第十摩竭宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "至女、虛日，南行大凶"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b1201": {
      "paragraph_xml_id": "pT21p0397b1201",
      "locator": "T21n1299_p0397b12",
      "main_text": "第一羊宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "至婁、胃、昴日，西行大凶"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b1301": {
      "paragraph_xml_id": "pT21p0397b1301",
      "locator": "T21n1299_p0397b13",
      "main_text": "第二牛宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "至畢、觜日，北行大凶"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0396b2101": {
      "paragraph_xml_id": "pT21p0396b2101",
      "locator": "T21n1299_p0396b21",
      "main_text": "壁宿，宜作求長壽增益法，不宜南行。宜造城邑、取衣取財、嫁娶婚姻等喜善事皆吉。",
      "inline_notes": [],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    }

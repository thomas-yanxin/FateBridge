  "passages": {
    "pT21p0397a2701": {
      "paragraph_xml_id": "pT21p0397a2701",
      "locator": "T21n1299_p0397a27",
      "main_text": "日屬軫宿，不得向北路行。",
      "inline_notes": [
        {
          "place": "inline",
          "text": "縱吉時亦不可行"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397a2801": {
      "paragraph_xml_id": "pT21p0397a2801",
      "locator": "T21n1299_p0397a28",
      "main_text": "日屬女宿，不得向東行。",
      "inline_notes": [
        {
          "place": "inline",
          "text": "縱吉時亦不可行"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397a2901": {
      "paragraph_xml_id": "pT21p0397a2901",
      "locator": "T21n1299_p0397a29",
      "main_text": "日屬鬼宿，不得向西行。",
      "inline_notes": [
        {
          "place": "inline",
          "text": "縱吉時亦不可行"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0101": {
      "paragraph_xml_id": "pT21p0397b0101",
      "locator": "T21n1299_p0397b01",
      "main_text": "日屬婁宿，不得向南行。",
      "inline_notes": [
        {
          "place": "inline",
          "text": "縱吉時亦不可行"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0201": {
      "paragraph_xml_id": "pT21p0397b0201",
      "locator": "T21n1299_p0397b02",
      "main_text": "第七秤宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "取角、亢日"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0301": {
      "paragraph_xml_id": "pT21p0397b0301",
      "locator": "T21n1299_p0397b03",
      "main_text": "第十一瓶宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "取危、室日，已上東行大吉"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0401": {
      "paragraph_xml_id": "pT21p0397b0401",
      "locator": "T21n1299_p0397b04",
      "main_text": "第五獅子宮",
      "inline_notes": [
        {
          "place": "inline",
          "text": "取星、張日"
        }
      ],
      "text_placement_basis": "explicit_publisher_TEI_note_place_inline",
      "inline_author_identity_independently_established": false
    },
    "pT21p0397b0501": {
      "paragraph_xml_id": "pT21p0397b0501",
      "locator": "T21n1299_p0397b05",
      "main_text": "第九弓宮",
      "inline_notes": [
        {

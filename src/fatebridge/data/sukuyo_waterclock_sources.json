  "T2216_internal_comparison": {
    "edition": "Same SAT Taisho electronic work, two locators; not two independent witnesses.",
    "early": {
      "locator": "T2216_.59.0058a23-26",
      "main_literal": "毎日分爲八時。平明即是所直之曜。乃至酉戌則八時而周。夜亦分爲八時。轉到明日曉時。即次後曜當直。如是細解用之萬不失一些些疑文云。晝夜八時名目。如何",
      "day_parts": 8,
      "night_parts": 8
    },
    "early_daily_ruler": {
      "locator": "T2216_.59.0058b07-09",
      "main_literal": "竺暦名正著時。此執持義正著時者。是當毎日平明也。從此以後。日月五星。各主一日一夜。而七箇日次第輪轉也"
    },
    "later": {
      "locator": "T2216_.59.0233b14-16",
      "main_literal": "依宿曜經晝夜八時之中。平明爲曜直時。謂曉旦時直日執曜與宿相合。故云正著時歟此執持義等者。第四云。九執者。",
      "inline_small_type": {
        "0233b14": [
          "下之十五",
          "晝四時夜四時"
        ]
      },
      "total_day_night_parts": 8,
      "day_parts_in_small_type": 4,
      "night_parts_in_small_type": 4,
      "conjectural_marker": "歟",
      "small_type_author_or_date_established": false
    },
    "counts_equal": false,
    "editorial_or_witness_cause_resolved": false,
    "eight_part_luminary_order_established": false
  },
  "T1299_control": {
    "locator": "T21n1299_p0399b25-28",
    "literal": "國，未審知委。其曜亦每日分為八時，平明即是所直之曜，乃至酉戌，則八時而周。夜亦分為八時，轉到明日曉時，即次後曜當直。如是細解，用之萬不失一。",
    "day_parts": 8,
    "night_parts": 8
  },

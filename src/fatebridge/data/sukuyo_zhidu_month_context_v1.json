  "quotation_comparisons": {
    "T1509_X0439_T2217": [
      "T1509主文是“日名從旦至旦”；冻结X0439电子正文亦作旦至旦。冻结T2217 SAT主文则作旦至夕，另有“夕＝且＜甲＞”校记。这些是不同来源层的实际读数，不能用上游旦字覆盖后引夕字或甲号且字。",
      "T1509写“五月至，晝十八時，夜十二時；十一月至，夜十八時，晝十二時”。X0439及T2217所录引文省去这些位置的至字，并把十一月的具体两数缩为“十一月翻……”式表述。",
      "X0439当前电子标点为“十一月翻。此言十五時屬晝，三分中各五時也”；T2217记录为“十一月翻此。言十五時屬晝三分中各五時也”。标点层和实际字串须分别保留。",
      "“三分中各五時也”不在T1509所核日段中，是后引尾部的解释性展开，不能反写成上游原句。",
      "两部所核后引到这一说明为止，没有交付T1509紧接着的四种月、分数、闰月、岁数及日月岁缘成论述。"
    ],
    "T2122_T1509": [
      {
        "topic": "实际卷篇部与阿鞞跋致句的指代",
        "finding": "本次T2122所在位置是卷四、日月篇第三、亏盈部第七。T1509该日月岁节段实际在卷48《四念處品第十九》。T1509“如阿鞞跋致品中所說”属于前一“巧知往來坐起等”的解释段；T2122将这句纳入当前引文开头，不能据此重标两处实际品题。"
      },
      {
        "topic": "昼夜计数",
        "T2122": "夜亦有三分；春秋分十五／十五；若五月至昼十八、夜十二；十一月至夜十八、昼十二。",
        "T1509": "夜亦三分；春秋分十五／十五；五月至昼十八、夜十二；十一月至夜十八、昼十二。",
        "difference": "T2122有“有”和“若”等文字差别。两书相关计数对应，但这不等于已认证其全部时间制度、单位长度或实际测量相同。"
      },
      {
        "topic": "月长概列",
        "T2122": "一月或三十日半。或三十日。或二十九日半。或二十七日半。",
        "T1509": "一月，或三十日、或三十日半、或二十九日、或二十七日半。",
        "difference": "前三十日与三十日半的顺序不同；二十九日半与二十九日不同。T1509二十七日半还另有七／九【石】校记。不得将概列强行统一。"
      },
      {
        "topic": "月月与星宿月的详细分数",
        "T2122": "月月者二十九日。加六十二分之三十。星宿月者。二十七日加六十分之二十一。",
        "T1509": "月月者，二十九日加六十二分之三十；星宿月者，二十七日加六十七分之二十一。",
        "difference": "月月的数值对应；星宿月分母明确为六十／六十七。T2122目标段相交校注没有提供改动这个分母的记录，T1509对应窗口也没有改动六十七的校注。这里保留两个正文值，不按现代月长或算术接近程度择优。"
      },
      {
        "topic": "闰月与岁",
        "T2122": "閏月者從日月世間月二事中出。是名十三月。或十三月名一歲。是歲三百六十六日。周而復始。",
        "T1509": "閏月者，從日月、世間月二事中出，是名十三月。或十二月、或十三月，名一歲。是歲三百六十六日，周而復始。",
        "difference": "T2122未载T1509的“或十二月”分支；不能替它补写，也不能因只见“或十三月”就改说本书规定每年一律十三个月。两处366日原数均保留。"
      },
      {
        "topic": "中分、空空及月岁缘成",
        "T2122": "中分無住處。無相可取日分。空空無所有。到三十日。時二十九日減。云何和合成日月。無故云何和合而為歲。",
        "T1509": "中分中無住處，無相可取，日分空無所有。到三十日時，二十九日已滅，云何和合成月？月無故，云何和合而為歲？",
        "difference": "T2122少一个中，实际写空空，并有減／已滅、成日月／成月及后续月字、句读位置等差别。没有把T2122改排为T1509的流畅句法，也没有删掉重出的空字。"
      },
      {
        "topic": "校记归属",
        "finding": "T2122末旦／日校记与T1509月月术语的月／日校记是不同文件、不同位置、不同见证集合。T2122内联注的災／交／央又是第三个位置。它们都不能挪作星宿月分母、T2217夕／且或T1299平明的校记。"
      }
    ],

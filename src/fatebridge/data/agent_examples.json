    "firdaria": {
      "scope": "普通人生阶段问题的正常候选，窄查只用本工具，不默认运行全部西占时运。",
      "field_root": "单项读 firdaria.current_major/current_sub；聚合读 time_lords.firdaria.current_major/current_sub，不复制前缀。",

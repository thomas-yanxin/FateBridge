{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fatebridge": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "--isolated", "--with-requirements", "${PLUGIN_ROOT}/backend-requirements.txt", "--from", "${PLUGIN_ROOT}", "fatebridge-mcp"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "FATEBRIDGE_MCP_FAMILIES": "",
        "FATEBRIDGE_MCP_SCENARIOS": "",
        "FATEBRIDGE_MCP_TOOL_SCOPE": "complete"
      }
    }
  }
}
